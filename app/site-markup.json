"\n  <a class=\"skip\" href=\"#composer\">Skip to writing</a>\n\n  <nav class=\"nav\">\n    <a href=\"#\" class=\"nav-brand\">\n      <div class=\"nav-icon\" aria-hidden=\"true\"><span data-sprite=\"envelope\" data-px=\"2\"></span></div>\n      <div class=\"nav-wordmark\">PENPAL<br>PIXEL</div>\n    </a>\n    <ul class=\"nav-links\">\n      <li><a href=\"#how\">How it works</a></li>\n      <li><a href=\"#composer\">Write</a></li>\n      <li><a href=\"#features\">Details</a></li>\n      <li><a href=\"#faq\">Questions</a></li>\n    </ul>\n    <a href=\"#composer\" class=\"nav-btn\"><span data-sprite=\"pencil\" data-px=\"2\"></span> Write now</a>\n    <div class=\"nav-tools\">\n      <button type=\"button\" class=\"tool-btn\" id=\"soundBtn\" aria-pressed=\"false\" aria-label=\"Sound effects: off\" title=\"Sound effects (off)\">&#x1F507;</button>\n      <button type=\"button\" class=\"tool-btn\" id=\"themeBtn\" aria-pressed=\"false\" aria-label=\"Starry night theme\" title=\"Starry night\">&#x1F319;</button>\n      <button type=\"button\" class=\"tool-btn nav-menu\" id=\"menuBtn\" aria-expanded=\"false\" aria-controls=\"mnav\" aria-label=\"Open menu\"><span data-sprite=\"mailbox\" data-px=\"2\"></span></button>\n    </div>\n  </nav>\n\n  <div class=\"mnav\" id=\"mnav\" hidden>\n    <div class=\"mnav-in\">\n      <p class=\"mnav-hi\">Where to?</p>\n      <ul>\n        <li><a href=\"#how\">How it works</a></li>\n        <li><a href=\"#composer\">Write a letter</a></li>\n        <li><a href=\"#features\">Little details</a></li>\n        <li><a href=\"#kindness\">Kindness</a></li>\n        <li><a href=\"#faq\">Questions</a></li>\n      </ul>\n      <a href=\"#composer\" class=\"btn-px btn-pri\"><span data-sprite=\"pencil\" data-px=\"2\"></span> Write now</a>\n    </div>\n  </div>\n\n  <!-- HERO -->\n  <section class=\"hero\" id=\"home\">\n    <canvas id=\"aweSky\" class=\"awe-sky\" aria-hidden=\"true\"></canvas>\n    <div class=\"star-field\" id=\"sf\"></div>\n    <div class=\"cloud\" style=\"top:12%;--cd:28s;--co:0s;left:-200px\">\n      <div class=\"cloud-s\"></div>\n    </div>\n    <div class=\"cloud\" style=\"top:34%;--cd:40s;--co:-15s;left:-200px\">\n      <div class=\"cloud-s\" style=\"width:80px;height:30px\"></div>\n    </div>\n    <div class=\"cloud\" style=\"top:62%;--cd:55s;--co:-28s;left:-200px;opacity:.65\">\n      <div class=\"cloud-s\" style=\"width:48px;height:22px\"></div>\n    </div>\n\n    <div class=\"hero-scene\" aria-hidden=\"true\">\n      <span class=\"hs hs1\" data-sprite=\"heart\" data-px=\"4\"></span>\n      <span class=\"hs hs2\" data-sprite=\"star\" data-px=\"4\"></span>\n      <span class=\"hs hs3\" data-sprite=\"sparkle\" data-px=\"4\"></span>\n      <span class=\"hs hs4\" data-sprite=\"heart\" data-px=\"3\"></span>\n      <span class=\"hs hs5\" data-sprite=\"cloud\" data-px=\"6\"></span>\n    </div>\n    <div class=\"hero-village\" id=\"heroVillage\" aria-hidden=\"true\"></div>\n    <div class=\"hero-content\">\n      <div class=\"hero-mascot\" aria-hidden=\"true\"><span data-sprite=\"mascot\" data-px=\"7\"></span></div>\n      <div class=\"hero-badge\">a little note, made with love</div>\n      <h1 class=\"hero-h1\">Write a letter<span class=\"pink\">they'll keep forever</span></h1>\n      <p class=\"hero-sub\">Pick a mood, say the kind thing, tuck in a few photos, and seal it with a tiny wax heart. It only takes a few minutes, and no one's grading your handwriting.</p>\n\n      <div class=\"hero-btns\">\n        <a href=\"#composer\" class=\"btn-px btn-pri\"><span data-sprite=\"envelope\" data-px=\"2\"></span> Write a letter</a>\n        <a href=\"#how\" class=\"btn-px btn-ghost\">See how it works</a>\n      </div>\n      <p class=\"hero-trust\"><span>Free</span><span>No sign-up</span><span>Stays on your device</span></p>\n    </div>\n\n    <div class=\"hero-ground\">\n      <span class=\"gf\" style=\"left:7%;--fi:0;--fo:0s\">&#x1F338;</span>\n      <span class=\"gf\" style=\"left:18%;--fi:1;--fo:.3s\">&#x1F33C;</span>\n      <span class=\"gf\" style=\"left:30%;--fi:2;--fo:.7s\">&#x1F33A;</span>\n      <span class=\"gf\" style=\"left:44%;--fi:.5;--fo:.2s\">&#x1F340;</span>\n      <span class=\"gf\" style=\"left:59%;--fi:1.5;--fo:.5s\">&#x1F33B;</span>\n      <span class=\"gf\" style=\"left:74%;--fi:.8;--fo:.4s\">&#x1F338;</span>\n      <span class=\"gf\" style=\"left:88%;--fi:2;--fo:.1s\">&#x1F33C;</span>\n    </div>\n    <div class=\"scroll-cue\"><span>SCROLL</span>\n      <div class=\"scroll-arrow\"></div>\n    </div>\n  </section>\n\n  <div class=\"dither\" aria-hidden=\"true\"></div>\n\n  <!-- HOW IT WORKS -->\n  <section class=\"sec how-sec\" id=\"how\">\n    <div class=\"sec-in\">\n      <span class=\"sec-eye\">&#x2736; the unhurried version &#x2736;</span>\n      <h2 class=\"sec-h2\">Four small steps, one quiet letter</h2>\n      <p class=\"sec-p\">From a blank page to something someone will keep &#x2014; as gentle as writing on a quiet\n        afternoon with tea going cold beside you.</p>\n      <div class=\"steps-grid\">\n        <div class=\"step-card fi\">\n          <span class=\"step-emoji\" aria-hidden=\"true\"><span data-sprite=\"pencil\" data-px=\"4\"></span></span>\n          <div class=\"step-num\">01</div>\n          <h3 class=\"step-title\">Write what you'd say in person</h3>\n          <p class=\"step-body\">Pour your feelings onto ruled paper. Choose your paper color, sprinkle a few stickers,\n            and let your words sit in a warm handwriting style.</p>\n        </div>\n        <div class=\"step-card fi\">\n          <span class=\"step-emoji\" aria-hidden=\"true\"><span data-sprite=\"camera\" data-px=\"4\"></span></span>\n          <div class=\"step-num\">02</div>\n          <h3 class=\"step-title\">Tuck in a few photographs</h3>\n          <p class=\"step-body\">Add the pictures that mean something to the two of you. They fan out gently in a small\n            photo album tucked right into the letter.</p>\n        </div>\n        <div class=\"step-card fi\">\n          <span class=\"step-emoji\" aria-hidden=\"true\"><span data-sprite=\"mailbox\" data-px=\"4\"></span></span>\n          <div class=\"step-num\">03</div>\n          <h3 class=\"step-title\">Seal your letter</h3>\n          <p class=\"step-body\">Choose a stamp and wax seal, then download your letter as a file, with your words and photos together.</p>\n        </div>\n        <div class=\"step-card fi\">\n          <span class=\"step-emoji\" aria-hidden=\"true\"><span data-sprite=\"heart\" data-px=\"4\"></span></span>\n          <div class=\"step-num\">04</div>\n          <h3 class=\"step-title\">Share it your way</h3>\n          <p class=\"step-body\">Send the file yourself by email or chat, whenever you feel ready. Your letter stays on your device until you share it.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"px-div\" data-div=\"clothes\" data-walker=\"-12\" style=\"--dbg:#FFEFD6\" aria-hidden=\"true\"></div>\n\n  <!-- COMPOSER -->\n  <section class=\"sec comp-sec fade-in\" id=\"composer\">\n    <div class=\"sec-in\">\n      <span class=\"sec-eye\">&#x2736; the page is waiting &#x2736;</span>\n      <h2 class=\"sec-h2\">Say the thing you'd say if you had more time</h2>\n      <p class=\"sec-p\">Just the page, your words, and someone in mind. Take your time; your draft stays on this device.</p>\n\n      <div class=\"desk-status\">\n        <div class=\"desk-status-copy\">\n          <span class=\"desk-status-icon\" data-sprite=\"envelope\" data-px=\"3\" aria-hidden=\"true\"></span>\n          <div class=\"desk-status-text\">\n            <strong id=\"deskTitle\">A little space for your words</strong>\n            <span id=\"deskDetail\">Start with a blank page or choose a starter below.</span>\n          </div>\n        </div>\n        <button type=\"button\" class=\"quiet-toggle\" id=\"quietToggle\" aria-pressed=\"false\" aria-controls=\"demo-panel writing-prompts\">Quiet writing: off</button>\n      </div>\n\n      <details class=\"starter-panel\" id=\"demo-panel\">\n        <summary><span class=\"starter-label\">Need a little inspiration?<small>Choose an optional starter</small></span></summary>\n        <div class=\"starter-content\">\n        <p class=\"occ-hint\">Choose an occasion to start with a sample. You can change every word.</p>\n        <div class=\"occ-grid\" role=\"group\" aria-label=\"Occasion\">\n          <button type=\"button\" class=\"occ\" data-k=\"birthday\" aria-pressed=\"false\" onclick=\"loadDemo('birthday')\"><span class=\"e\" data-sprite=\"cake\" data-px=\"3\"></span>Birthday</button>\n          <button type=\"button\" class=\"occ\" data-k=\"anniversary\" aria-pressed=\"false\" onclick=\"loadDemo('anniversary')\"><span class=\"e\" data-sprite=\"heart\" data-px=\"3\"></span>Anniversary</button>\n          <button type=\"button\" class=\"occ\" data-k=\"lovenote\" aria-pressed=\"false\" onclick=\"loadDemo('lovenote')\"><span class=\"e\" data-sprite=\"sparkle\" data-px=\"3\"></span>Love note</button>\n          <button type=\"button\" class=\"occ\" data-k=\"thankyou\" aria-pressed=\"false\" onclick=\"loadDemo('thankyou')\"><span class=\"e\" data-sprite=\"flower\" data-px=\"3\"></span>Thank you</button>\n          <button type=\"button\" class=\"occ\" data-k=\"congrats\" aria-pressed=\"false\" onclick=\"loadDemo('congrats')\"><span class=\"e\" data-sprite=\"cap\" data-px=\"3\"></span>Congrats</button>\n          <button type=\"button\" class=\"occ\" data-k=\"missyou\" aria-pressed=\"false\" onclick=\"loadDemo('missyou')\"><span class=\"e\" data-sprite=\"moon\" data-px=\"3\"></span>Miss you</button>\n          <button type=\"button\" class=\"occ\" data-k=\"justbecause\" aria-pressed=\"false\" onclick=\"loadDemo('justbecause')\"><span class=\"e\" data-sprite=\"cloud\" data-px=\"3\"></span>Just because</button>\n          <button type=\"button\" class=\"occ\" data-k=\"getwell\" aria-pressed=\"false\" onclick=\"loadDemo('getwell')\"><span class=\"e\" data-sprite=\"tea\" data-px=\"3\"></span>Get well</button>\n          <button type=\"button\" class=\"occ\" data-k=\"bestfriend\" aria-pressed=\"false\" onclick=\"loadDemo('bestfriend')\"><span class=\"e\" data-sprite=\"star\" data-px=\"3\"></span>Best friend</button>\n          <button type=\"button\" class=\"occ\" data-k=\"parent\" aria-pressed=\"false\" onclick=\"loadDemo('parent')\"><span class=\"e\" data-sprite=\"gift\" data-px=\"3\"></span>To a parent</button>\n          <button type=\"button\" class=\"occ blank\" data-k=\"blank\" aria-pressed=\"false\" onclick=\"clearLetter()\"><span class=\"e\" data-sprite=\"pencil\" data-px=\"3\"></span>Blank page</button>\n        </div>\n        </div>\n      </details>\n\n      <div class=\"stepn\"><b>1</b> Write from the heart</div>\n      <div class=\"pip\" id=\"pip\">\n        <div class=\"pip-av\" aria-hidden=\"true\"><span data-sprite=\"mascot\" data-px=\"3\"></span></div>\n        <div class=\"pip-bub\" id=\"pipBub\" role=\"status\" aria-live=\"polite\">Hi, I'm Penny! Choose a starter or just begin. I'll be right here.</div>\n      </div>\n      <div class=\"prompts\" id=\"writing-prompts\" aria-label=\"Conversation starters\">\n        <span class=\"prompts-l\">Stuck? Try a starter:</span>\n        <button type=\"button\" class=\"note n1\" data-q=\"My favorite memory of us is...\">Favorite memory together?</button>\n        <button type=\"button\" class=\"note n2\" data-q=\"What I love most about you is...\">What do you love about them?</button>\n        <button type=\"button\" class=\"note n3\" data-q=\"Thank you for always...\">A thing they always do?</button>\n        <button type=\"button\" class=\"note n4\" data-q=\"I hope this year brings you...\">A wish for them?</button>\n      </div>\n\n      <div class=\"comp-grid\">\n        <!-- LEFT: Letter paper -->\n        <div>\n          <div class=\"ptoolbar\">\n            <span class=\"ptlabel\" style=\"margin-right:8px;\">Handwriting</span>\n            <button type=\"button\" class=\"fbtn sel\" data-f=\"Caveat\" aria-label=\"Caveat handwriting\" aria-pressed=\"true\" style=\"font-family:'Caveat',cursive;font-size:16px;\">A</button>\n            <button type=\"button\" class=\"fbtn\" data-f=\"Pacifico\" aria-label=\"Pacifico handwriting\" aria-pressed=\"false\" style=\"font-family:'Pacifico',cursive;font-size:12px;\">A</button>\n            <button type=\"button\" class=\"fbtn\" data-f=\"'Indie Flower'\" aria-label=\"Indie Flower handwriting\" aria-pressed=\"false\" style=\"font-family:'Indie Flower',cursive;font-size:14px;\">A</button>\n            <span style=\"width:12px;\"></span>\n            <span class=\"ptlabel\">Paper</span>\n            <button type=\"button\" class=\"pswatch sel\" style=\"background:#FFFDF5\" data-p=\"c\" title=\"Cozy cream\" aria-label=\"Cozy cream paper\" aria-pressed=\"true\"></button>\n            <button type=\"button\" class=\"pswatch\" style=\"background:#F8F2FF\" data-p=\"l\" title=\"Lavender dream\" aria-label=\"Lavender dream paper\" aria-pressed=\"false\"></button>\n            <button type=\"button\" class=\"pswatch\" style=\"background:#FFF0F6\" data-p=\"b\" title=\"Strawberry milk\" aria-label=\"Strawberry milk paper\" aria-pressed=\"false\"></button>\n            <button type=\"button\" class=\"pswatch\" style=\"background:#EFFFFA\" data-p=\"m\" title=\"Mint garden\" aria-label=\"Mint garden paper\" aria-pressed=\"false\"></button>\n            <button type=\"button\" class=\"pswatch\" style=\"background:#EFF7FF\" data-p=\"s\" title=\"Morning sky\" aria-label=\"Morning sky paper\" aria-pressed=\"false\"></button>\n            <button type=\"button\" class=\"pswatch\" style=\"background:#FFF5EA\" data-p=\"p\" title=\"Peach tea\" aria-label=\"Peach tea paper\" aria-pressed=\"false\"></button>\n          </div>\n          <div class=\"ptoolbar ptoolbar2\">\n            <span class=\"ptlabel\">Stamp</span>\n            <div class=\"stamp-pick\" role=\"group\" aria-label=\"Stamp\">\n              <button type=\"button\" class=\"stp sel\" data-st=\"heart\" aria-label=\"Heart stamp\" aria-pressed=\"true\"><span data-sprite=\"heart\" data-px=\"2\"></span></button>\n              <button type=\"button\" class=\"stp\" data-st=\"star\" aria-label=\"Star stamp\" aria-pressed=\"false\"><span data-sprite=\"star\" data-px=\"2\"></span></button>\n              <button type=\"button\" class=\"stp\" data-st=\"flower\" aria-label=\"Flower stamp\" aria-pressed=\"false\"><span data-sprite=\"flower\" data-px=\"2\"></span></button>\n              <button type=\"button\" class=\"stp\" data-st=\"moon\" aria-label=\"Moon stamp\" aria-pressed=\"false\"><span data-sprite=\"moon\" data-px=\"2\"></span></button>\n            </div>\n            <span class=\"ptlabel\">Wax</span>\n            <div class=\"wax-pick\" role=\"group\" aria-label=\"Wax seal color\">\n              <button type=\"button\" class=\"wxp sel\" data-wx=\"#E8445A\" style=\"--w:#E8445A\" aria-label=\"Rose wax\" aria-pressed=\"true\"></button>\n              <button type=\"button\" class=\"wxp\" data-wx=\"#9050E0\" style=\"--w:#9050E0\" aria-label=\"Plum wax\" aria-pressed=\"false\"></button>\n              <button type=\"button\" class=\"wxp\" data-wx=\"#50B898\" style=\"--w:#50B898\" aria-label=\"Mint wax\" aria-pressed=\"false\"></button>\n              <button type=\"button\" class=\"wxp\" data-wx=\"#E8A020\" style=\"--w:#E8A020\" aria-label=\"Honey wax\" aria-pressed=\"false\"></button>\n            </div>\n          </div>\n          <div class=\"letter-paper pc\" id=\"lp\">\n            <div class=\"paper-holes\">\n              <div class=\"hole\"></div>\n              <div class=\"hole\"></div>\n              <div class=\"hole\"></div>\n            </div>\n            <input type=\"text\" class=\"lt-field lt-to\" id=\"lt-to\" aria-label=\"Greeting\" placeholder=\"Dear ______,\" maxlength=\"60\">\n            <span class=\"lt-date\" id=\"lt-date\"></span>\n            <textarea class=\"lt-body\" id=\"lt-body\" aria-label=\"Letter message\"\n              placeholder=\"I've been thinking about you lately and wanted to write to say...\" spellcheck=\"true\"\n              rows=\"10\" maxlength=\"6000\"></textarea>\n            <input type=\"text\" class=\"lt-field lt-sign\" id=\"lt-sign\" aria-label=\"Sign-off\" placeholder=\"With love, ______\" maxlength=\"60\">\n            <div class=\"letter-meta\">\n              <span id=\"wordCount\">0 words</span>\n              <span id=\"autoSaveInd\" style=\"opacity:0; transition:opacity 0.3s;\">saved with love &#x1F4BE;</span>\n            </div>\n            <div class=\"sticker-bar\">\n              <span class=\"sticker-lbl\">Sticker sheet</span>\n              <button class=\"sk-btn\" onclick=\"sk('&#x1F495;')\">&#x1F495;</button>\n              <button class=\"sk-btn\" onclick=\"sk('&#x2B50;')\">&#x2B50;</button>\n              <button class=\"sk-btn\" onclick=\"sk('&#x1F338;')\">&#x1F338;</button>\n              <button class=\"sk-btn\" onclick=\"sk('&#x2728;')\">&#x2728;</button>\n              <button class=\"sk-btn\" onclick=\"sk('&#x1F380;')\">&#x1F380;</button>\n              <button class=\"sk-btn\" onclick=\"sk('&#x1F98B;')\">&#x1F98B;</button>\n              <button class=\"sk-btn\" onclick=\"sk('&#x1F308;')\">&#x1F308;</button>\n              <button class=\"sk-btn\" onclick=\"sk('&#x1F340;')\">&#x1F340;</button>\n              <button class=\"sk-btn\" onclick=\"sk('&#x1F3B5;')\">&#x1F3B5;</button>\n              <button class=\"sk-btn\" onclick=\"sk('&#x1F423;')\">&#x1F423;</button>\n              <button class=\"sk-btn\" onclick=\"sk('&#x1F319;')\">&#x1F319;</button>\n              <button class=\"sk-btn\" onclick=\"sk('&#x1F353;')\">&#x1F353;</button>\n              <button class=\"sk-btn\" onclick=\"sk('&#x2601;&#xFE0F;')\">&#x2601;&#xFE0F;</button>\n              <button class=\"sk-btn\" onclick=\"sk('&#x1F33B;')\">&#x1F33B;</button>\n              <button class=\"sk-btn\" onclick=\"sk('&#x1F408;')\">&#x1F408;</button>\n              <button class=\"sk-btn\" onclick=\"sk('&#x1F33A;')\">&#x1F33A;</button>\n            </div>\n          </div>\n        </div>\n\n        <!-- RIGHT: Album + Send -->\n        <div class=\"right-pane\">\n          <!-- Photo Album -->\n          <div class=\"album-box\">\n            <div class=\"stepn\"><b>2</b> Tuck in photos <span>(optional)</span></div>\n            <div class=\"album-hdr\">\n              <h3 class=\"album-title\">Our little scrapbook</h3>\n              <span class=\"photo-badge\" id=\"phcount\">0 photos</span>\n            </div>\n            <div class=\"album-stage\" id=\"alstage\">\n              <div class=\"album-empty\" id=\"alempty\">\n                <span data-sprite=\"camera\" data-px=\"6\"></span>\n                <p>Add a memory!<br>A photo makes it even sweeter.</p>\n              </div>\n            </div>\n            <div class=\"paste-zone\" id=\"pzone\" role=\"button\" tabindex=\"0\" aria-label=\"Add photos\" onclick=\"document.getElementById('fi').click()\">\n              <p>Tap to add photos, or paste / drop them here<br>JPG &middot; PNG &middot; WEBP &middot; GIF\n              </p>\n              <input type=\"file\" id=\"fi\" accept=\"image/*\" multiple style=\"display:none\">\n            </div>\n            <div class=\"album-controls\">\n              <button class=\"al-btn\" onclick=\"prevPh()\" aria-label=\"Previous photo\">&#x25C4; Back</button>\n              <button class=\"al-btn\" onclick=\"nextPh()\" aria-label=\"Next photo\">Next &#x25BA;</button>\n              <button class=\"al-btn danger\" onclick=\"removePh()\">Remove</button>\n            </div>\n          </div>\n\n          <!-- Export Form -->\n          <div class=\"send-box\">\n            <div class=\"stepn\"><b>3</b> Seal &amp; share</div>\n            <p class=\"send-note\">We'll fold your letter into a little file you can send by email, WhatsApp, or any chat. Nothing leaves your device until you share it.</p>\n            <button class=\"send-btn-main\" id=\"exportbtn\" onclick=\"exportLetter()\">\n              <span id=\"exportlbl\"><span data-sprite=\"envelope\" data-px=\"2\"></span> Seal &amp; download</span>\n            </button>\n            <button class=\"btn-soft\" onclick=\"previewLetter()\">Peek at it first</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"px-div\" data-div=\"flowers\" data-walker=\"-30\" style=\"--dbg:#FFD6B0\" aria-hidden=\"true\"></div>\n\n  <!-- FEATURES -->\n  <section class=\"sec feat-sec fade-in\" id=\"features\">\n    <div class=\"sec-in\">\n      <span class=\"sec-eye\">&#x2736; the small things &#x2736;</span>\n      <h2 class=\"sec-h2\">Every small detail, considered</h2>\n      <p class=\"sec-p\">Nothing flashy. Just the things that make a letter feel like it was made for one person,\n        by hand, and nobody else.</p>\n      <div class=\"feat-grid fade-in\">\n        <div class=\"feat-card fi\">\n          <div class=\"feat-icon\" aria-hidden=\"true\"><span data-sprite=\"paper\" data-px=\"3\"></span></div>\n          <h3 class=\"feat-title\">Paper that feels like paper</h3>\n          <p class=\"feat-body\">Six paper colors &#x2014; cream, lavender, blush, mint, sky &amp; peach. Ruled\n            lines, hole punches &amp; washi tape, the way a real page would look.</p>\n        </div>\n        <div class=\"feat-card fi\">\n          <div class=\"feat-icon\" aria-hidden=\"true\"><span data-sprite=\"camera\" data-px=\"3\"></span></div>\n          <h3 class=\"feat-title\">A small photo album, tucked in</h3>\n          <p class=\"feat-body\">Paste or upload photos that fan out in a gentle 3D stack, sent to your\n            recipient as part of the letter itself.</p>\n        </div>\n        <div class=\"feat-card fi\">\n          <div class=\"feat-icon\" aria-hidden=\"true\"><span data-sprite=\"sparkle\" data-px=\"3\"></span></div>\n          <h3 class=\"feat-title\">A few stickers, if you want them</h3>\n          <p class=\"feat-body\">Sixteen small stickers &#x2014; hearts, flowers, cats, moons &amp; more. A little\n            sparkle here and there, never the whole page.</p>\n        </div>\n        <div class=\"feat-card fi\">\n          <div class=\"feat-icon\" aria-hidden=\"true\"><span data-sprite=\"envelope\" data-px=\"3\"></span></div>\n          <h3 class=\"feat-title\">Ready to share</h3>\n          <p class=\"feat-body\">Download a self-contained HTML letter and attach it to an email or share it privately\n            &#x2014; no app to download and nothing to sign up for.</p>\n        </div>\n        <div class=\"feat-card fi\">\n          <div class=\"feat-icon\" aria-hidden=\"true\"><span data-sprite=\"pencil\" data-px=\"3\"></span></div>\n          <h3 class=\"feat-title\">A hand, not a font</h3>\n          <p class=\"feat-body\">Letters are set in a warm, slightly imperfect handwriting style &#x2014; closer\n            to ink than to type.</p>\n        </div>\n        <div class=\"feat-card fi\">\n          <div class=\"feat-icon\" aria-hidden=\"true\"><span data-sprite=\"floppy\" data-px=\"3\"></span></div>\n          <h3 class=\"feat-title\">Nothing gets lost</h3>\n          <p class=\"feat-body\">Your letter saves quietly as you type. Come back later and find it right where you\n            left off.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"px-div\" data-div=\"flowers\" style=\"--dbg:#F7B2BE\" aria-hidden=\"true\"></div>\n  <!-- KINDNESS -->\n  <section class=\"sec kind-sec fade-in\" id=\"kindness\">\n    <div class=\"sec-in\">\n      <span class=\"sec-eye\">&#x2736; a quiet corner &#x2736;</span>\n      <h2 class=\"sec-h2\">Gentle by design</h2>\n      <p class=\"sec-p\">No feeds, no followers, no pressure. Just you, a page, and someone you care about.</p>\n      <div class=\"guardian\">\n        <div class=\"pip\">\n          <div class=\"pip-av\" aria-hidden=\"true\"><span data-sprite=\"mascot\" data-px=\"3\"></span></div>\n          <div class=\"pip-bub\">I keep watch over the village. Your words stay yours.</div>\n        </div>\n      </div>\n      <div class=\"kind-grid\">\n        <div class=\"kind-card fi\">\n          <span aria-hidden=\"true\" data-sprite=\"heart\" data-px=\"3\"></span>\n          <h3>No accounts, no feeds</h3>\n          <p>There&rsquo;s nothing to join and nobody to follow. You open the page and write.</p>\n        </div>\n        <div class=\"kind-card fi\">\n          <span aria-hidden=\"true\" data-sprite=\"paper\" data-px=\"3\"></span>\n          <h3>Your words stay with you</h3>\n          <p>Letters and photos are put together right here in your browser. Nothing is posted anywhere.</p>\n        </div>\n        <div class=\"kind-card fi\">\n          <span aria-hidden=\"true\" data-sprite=\"mailbox\" data-px=\"3\"></span>\n          <h3>You choose who gets it</h3>\n          <p>Download your letter and send it the way you trust: email, a chat, or tucked into a card.</p>\n        </div>\n        <div class=\"kind-card fi\">\n          <span aria-hidden=\"true\" data-sprite=\"sparkle\" data-px=\"3\"></span>\n          <h3>Made to be kind</h3>\n          <p>Starter notes lean warm and gentle. No streaks, no countdowns, no nudges to hurry.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"px-div\" data-div=\"flowers\" style=\"--dbg:#D4C4EE\" aria-hidden=\"true\"></div>\n\n  <!-- FAQ -->\n  <section class=\"sec faq-sec fade-in\" id=\"faq\">\n    <div class=\"sec-in\">\n      <span class=\"sec-eye\">&#x2736; little notes &#x2736;</span>\n      <h2 class=\"sec-h2\">Questions, answered kindly</h2>\n      <p class=\"sec-p\">Open a note to read it. They&rsquo;re all short.</p>\n      <div class=\"faq-list\">\n        <details class=\"faq-item fi\">\n          <summary>Is Penpal Pixel really free?</summary>\n          <p class=\"faq-a\">Yes. There&rsquo;s no sign-up and nothing to pay. You can write as many letters as you like.</p>\n        </details>\n        <details class=\"faq-item fi\">\n          <summary>What happens when I press &ldquo;Seal &amp; download&rdquo;?</summary>\n          <p class=\"faq-a\">Your letter becomes a single file saved on your device. Open it in any browser, or attach it to an email or chat message.</p>\n        </details>\n        <details class=\"faq-item fi\">\n          <summary>Is my writing saved while I type?</summary>\n          <p class=\"faq-a\">Your words are saved in this browser, so you can close the tab and come back. Photos aren&rsquo;t kept between visits, so add them right before you seal the letter. Clearing your browser&rsquo;s site data removes the draft.</p>\n        </details>\n        <details class=\"faq-item fi\">\n          <summary>Can I send the letter straight from the page?</summary>\n          <p class=\"faq-a\">Not yet. For now, download the letter and send it yourself. It&rsquo;s one small file.</p>\n        </details>\n        <details class=\"faq-item fi\">\n          <summary>Do I have to add photos?</summary>\n          <p class=\"faq-a\">Not at all. A letter with only words is perfect. When you do add photos, they&rsquo;re tucked into the letter file itself.</p>\n        </details>\n        <details class=\"faq-item fi\">\n          <summary>Does it work on my phone?</summary>\n          <p class=\"faq-a\">It does. The page and the letter you send both resize to fit small screens.</p>\n        </details>\n      </div>\n    </div>\n  </section>\n\n\n\n  <!-- CTA: the evening village -->\n  <div class=\"cta-dither\" id=\"ctaDither\" aria-hidden=\"true\"></div>\n  <section class=\"cta-sec\" id=\"cta\">\n    <div class=\"star-field\" id=\"csf\"></div>\n    <div class=\"cta-moon\" aria-hidden=\"true\"><span data-sprite=\"moon\" data-px=\"8\"></span></div>\n    <div class=\"cta-fire\" id=\"fireflies\" aria-hidden=\"true\"></div>\n    <span class=\"shoot\" aria-hidden=\"true\" style=\"top:10%;left:72%\"></span><span class=\"shoot s2\" aria-hidden=\"true\"></span>\n    <div class=\"cta-in\">\n      <span class=\"cta-env\" aria-hidden=\"true\"><span data-sprite=\"envelope\" data-px=\"6\"></span></span>\n      <h2 class=\"cta-h2\">Who do you want to write to today?</h2>\n      <p class=\"cta-q\">&ldquo;Someone, somewhere, is waiting to feel remembered.<br>Your letter could be the thing that\n        makes their whole day.&rdquo;</p>\n      <div class=\"cta-btns\">\n        <a href=\"#composer\" class=\"btn-px btn-pri\"><span data-sprite=\"pencil\" data-px=\"2\"></span> Begin the letter</a>\n        <a href=\"#home\" class=\"btn-px btn-ghost\">Maybe later</a>\n      </div>\n      <div class=\"cta-desk\" aria-hidden=\"true\">\n        <span class=\"steam\"></span><span class=\"steam\"></span>\n        <span class=\"it paper\" data-sprite=\"paper\" data-px=\"8\"></span>\n        <span class=\"it tea\" data-sprite=\"tea\" data-px=\"6\"></span>\n        <span class=\"it lamp\" data-sprite=\"lantern\" data-px=\"8\"></span>\n        <div class=\"plank\"></div>\n      </div>\n    </div>\n    <div class=\"cta-village\" id=\"ctaVillage\" aria-hidden=\"true\"></div>\n  </section>\n\n  <!-- FOOTER -->\n  <footer class=\"footer\">\n    <div class=\"fence-top\" id=\"fenceTop\" aria-hidden=\"true\"></div>\n    <span class=\"footer-brand\"><span data-sprite=\"envelope\" data-px=\"2\" aria-hidden=\"true\"></span> PENPAL PIXEL</span>\n    <p class=\"footer-tag\">Made with warmth, one pixel at a time.<br>Because kindness deserves beautiful packaging.</p>\n    <ul class=\"footer-links\">\n      <li><a href=\"#how\">How it works</a></li>\n      <li><a href=\"#composer\">Write</a></li>\n      <li><a href=\"#features\">Details</a></li>\n      <li><a href=\"#kindness\">Kindness</a></li>\n      <li><a href=\"#faq\">Questions</a></li>\n    </ul>\n    <div class=\"footer-row\" aria-hidden=\"true\">\n      <span data-sprite=\"flower\" data-px=\"3\"></span><span data-sprite=\"heart\" data-px=\"3\"></span><span data-sprite=\"star\" data-px=\"3\"></span><span data-sprite=\"moon\" data-px=\"3\"></span><span data-sprite=\"cloud\" data-px=\"3\"></span><span data-sprite=\"cake\" data-px=\"3\"></span>\n    </div>\n    <p class=\"footer-sign\">Write slowly. Be kind. Make someone&rsquo;s day.</p>\n    <div class=\"footer-cat\" aria-hidden=\"true\"><span data-sprite=\"cat\" data-px=\"4\"></span></div>\n  </footer>\n\n  <div class=\"seal-ov\" id=\"sealOv\" hidden role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"sealT\">\n    <div class=\"seal-card\">\n      <button type=\"button\" class=\"seal-close\" onclick=\"closeSeal()\" aria-label=\"Close\">&times;</button>\n      <div class=\"ss\" aria-hidden=\"true\">\n        <div class=\"ss-back\"></div>\n        <div class=\"ss-paper\"><span>Dear you,</span><i></i><i></i><i></i></div>\n        <div class=\"ss-front\"></div>\n        <div class=\"ss-flap\"></div>\n        <div class=\"ss-wax\" id=\"ssWax\"></div>\n      </div>\n      <h3 id=\"sealT\">Sealed with love</h3>\n      <p>Your letter is ready to make someone's day. It's saved in your downloads, so just send it their way.</p>\n      <div class=\"seal-actions\">\n        <button type=\"button\" class=\"btn-px btn-pri\" onclick=\"peekFromSeal()\">Peek at it</button>\n        <button type=\"button\" class=\"btn-px btn-soft\" onclick=\"newFromSeal()\">Write another</button>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"toast\" id=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n\n  \n\n\n"