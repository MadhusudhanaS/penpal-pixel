"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<title>A Letter & Photo Album ✉️📖</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Caveat:wght@400;600;700&family=Nunito:wght@400;600;700;800&family=Pacifico&family=Indie+Flower&display=swap\" rel=\"stylesheet\">\n\n<style>\n/* --- TRUE ANIME PIXEL ART AESTHETIC --- */\n:root {\n  --cream: #FFFDF5; \n  --blush: #FFB8D0; \n  --lav: #C8A8FF; \n  --mint: #8FDDC8; \n  --peach: #FFD4A8;\n  --sky: #A8D4FF; \n  --yel: #FFE066; \n  --br: #4A3728; \n  --bdr: #5C3D2E;\n  --bg-top: #FF9B71;\n  --bg-bot: #FFD4A8;\n  --pixel-shadow: 4px 4px 0 var(--bdr);\n}\n\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n/* --- CUSTOM PIXEL SCROLLBARS --- */\n* { scrollbar-color: var(--blush) rgba(0,0,0,0.1); scrollbar-width: thin; }\n::-webkit-scrollbar { width: 10px; }\n::-webkit-scrollbar-track { background: rgba(0,0,0,0.05); border-left: 3px solid var(--bdr); }\n::-webkit-scrollbar-thumb { background: var(--blush); border: 2px solid var(--bdr); }\n\nhtml, body { width: 100%; height: 100%; overflow: hidden; background: linear-gradient(-45deg, #0D0B2B, #1A1042, #28164E, #3A235D); background-size: 400% 400%; color: var(--br); font-family: 'Outfit', sans-serif; touch-action: manipulation; -webkit-tap-highlight-color: transparent; animation: scene-fade-in 2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards, mesh-gradient 15s ease infinite; }\n@keyframes mesh-gradient { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }\n@keyframes scene-fade-in { 0% { opacity: 0; filter: brightness(0.5); } 100% { opacity: 1; filter: brightness(1); } }\n\n\n/* Golden Hour Additions */\n\n.hanging-lantern {\n  position: absolute; top: -10px; right: 12vw; font-size: 70px;\n  transform-origin: top center; animation: sway 6s ease-in-out infinite;\n  filter: drop-shadow(0 0 40px rgba(255, 160, 120, 0.8)); z-index: 5;\n}\n@keyframes sway { 0%, 100% { transform: rotate(-5deg); } 50% { transform: rotate(5deg); } }\n\n.setting-sun {\n  position: absolute; bottom: 25vh; left: 50%; transform: translateX(-50%);\n  width: 250px; height: 250px; background: #FFAE73; border-radius: 50%;\n  box-shadow: 0 0 80px #FF9B71, 0 0 150px rgba(255, 155, 113, 0.6); z-index: 2; opacity: 0.9;\n}\n.sunbeam {\n  position: absolute; top: -20vh; bottom: 25vh;\n  background: linear-gradient(105deg, transparent, rgba(255, 240, 200, 0.25) 40%, rgba(255, 230, 150, 0.15) 60%, transparent);\n  transform: rotate(25deg); pointer-events: none; z-index: 4;\n  animation: pulse-light 6s infinite alternate; mix-blend-mode: overlay;\n}\n@keyframes pulse-light { 0% { opacity: 0.5; } 100% { opacity: 1; } }\n\n.dust-mote {\n  position: absolute; width: 4px; height: 4px; background: rgba(255, 240, 180, 0.8);\n  box-shadow: 0 0 6px rgba(255,255,255,0.9); pointer-events: none; z-index: 5;\n  animation: drift-mote linear infinite; opacity: 0;\n}\n@keyframes drift-mote {\n  0% { transform: translate(0, 0); opacity: 0; }\n  10% { opacity: 1; } 90% { opacity: 1; }\n  100% { transform: translate(60px, -80px); opacity: 0; }\n}\n\n/* Background & Desk */\n\n.desk-item-teacup {\n  position: absolute; bottom: 8vh; left: 15vw; font-size: 50px; z-index: 15;\n  filter: drop-shadow(8px 8px 0 rgba(0,0,0,0.3));\n}\n.steam {\n  position: absolute; bottom: 40px; width: 6px; height: 20px;\n  background: rgba(255,255,255,0.4); border-radius: 10px; filter: blur(2px);\n  animation: rise-steam 3s infinite ease-out; opacity: 0; pointer-events: none;\n}\n@keyframes rise-steam {\n  0% { transform: translateY(0) scale(1); opacity: 0; }\n  20% { opacity: 1; }\n  100% { transform: translateY(-50px) scale(2); opacity: 0; }\n}\n\n#environment { position: fixed; inset: 0; z-index: 1; display: flex; flex-direction: column; background: linear-gradient(to bottom, #FF9B71 0%, #FFD4A8 60%, #FFE9D6 100%); image-rendering: pixelated; }\n#environment::after { display: none; }\n#stars { \n  position: absolute; inset: 0; pointer-events: none; opacity: 0.5;\n  background-image: radial-gradient(2px 2px at 20px 30px, #fff, transparent), radial-gradient(2px 2px at 40px 70px, #fff, transparent), radial-gradient(2px 2px at 50px 160px, #fff, transparent), radial-gradient(2px 2px at 90px 40px, #fff, transparent);\n  background-repeat: repeat; background-size: 150px 150px; \n  animation: twinkle 4s infinite alternate; filter: none; \n}\n@keyframes twinkle { 0% { opacity: 0.2; } 100% { opacity: 0.8; } }\n\n/* Pixel Clouds */\n.pixel-cloud { position: absolute; width: 16px; height: 16px; background: rgba(255,255,255,0.1); box-shadow: 16px 0 0 rgba(255,255,255,0.1), 32px 0 0 rgba(255,255,255,0.1), 48px 0 0 rgba(255,255,255,0.1), 64px 0 0 rgba(255,255,255,0.1), 16px -16px 0 rgba(255,255,255,0.1), 32px -16px 0 rgba(255,255,255,0.1), 48px -16px 0 rgba(255,255,255,0.1), 32px -32px 0 rgba(255,255,255,0.1); animation: drift linear infinite; opacity: 0; }\n@keyframes drift { 0% { transform: translateX(-20vw); opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { transform: translateX(120vw); opacity: 0; } }\n\n#desk { position: absolute; bottom: 0; width: 100%; height: 25vh; background: #855E42; border-top: 8px solid #5C3D2E; box-shadow: inset 0 8px 0 rgba(0,0,0,0.2); image-rendering: pixelated; }\n#desk::before {\n  content: ''; position: absolute; inset: 0;\n  background-image: repeating-linear-gradient(90deg, transparent, transparent 64px, rgba(0,0,0,0.2) 64px, rgba(0,0,0,0.2) 68px),\n                    repeating-linear-gradient(0deg, rgba(0,0,0,0.05) 0, rgba(0,0,0,0.05) 4px, transparent 4px, transparent 16px);\n  pointer-events: none; mix-blend-mode: normal; opacity: 1;\n}\n#desk::after { display: none; }\n\n/* CRT Scanlines */\n#scanlines { position: fixed; inset: 0; pointer-events: none; z-index: 999; background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03)); background-size: 100% 4px, 6px 100%; box-shadow: inset 0 0 100px rgba(0,0,0,0.5); opacity: 0.8; }\n\n/* UI Layer */\n.ui-layer { position: fixed; inset: 0; z-index: 100; pointer-events: none; display: flex; flex-direction: column; justify-content: space-between; padding: 20px; }\n.top-bar { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }\n\n/* RPG Dialog Style Buttons */\n.btn, .status-chip { \n  pointer-events: auto; font-family: 'Nunito', sans-serif; font-size: 14px; font-weight: 800; border-radius: 0px; \n  color: var(--br); border: 4px solid var(--bdr); \n  box-shadow: 4px 4px 0 rgba(0,0,0,0.2); background: var(--cream); \n  padding: 10px 20px; cursor: pointer; transition: transform 0.1s, box-shadow 0.1s, background 0.1s; \n  text-decoration: none; display: inline-block; position: relative; \n  text-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; image-rendering: pixelated;\n}\n.btn::before { content: ''; position: absolute; inset: -8px; border: 4px solid rgba(255,255,255,0.5); pointer-events: none; opacity: 0; transition: opacity 0.2s; }\n.btn:hover { background: var(--peach); transform: translate(-2px, -2px); box-shadow: 6px 6px 0 rgba(0,0,0,0.2); border-color: var(--bdr); }\n.btn:active { transform: translate(4px, 4px); box-shadow: 0px 0px 0 rgba(0,0,0,0); }\n\n.status-chip { background: var(--cream); color: var(--br); cursor: default; display: flex; align-items: center; gap: 8px; border: 4px solid var(--bdr); }\n.status-chip::before { content: '✨'; animation: pulse 1s infinite alternate; filter: none; }\n@keyframes pulse { 0% { opacity: 0.5; transform: scale(0.9); } 100% { opacity: 1; transform: scale(1.1); } }\n\n.bottom-bar { display: flex; align-items: flex-end; justify-content: center; padding-bottom: 24px; gap: 16px; pointer-events: none; }\n.action-btn { background: #5C62C5 !important; border: 4px solid var(--bdr); color: var(--cream) !important; opacity: 0; transform: translateY(20px); pointer-events: none; transition: transform 0.2s, opacity 0.2s; text-shadow: 2px 2px 0 rgba(0,0,0,0.3); box-shadow: 4px 4px 0 rgba(0,0,0,0.3); border-radius: 0px; padding: 12px 24px; font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 16px; letter-spacing: 2px; cursor: pointer; text-decoration: none; text-transform: uppercase; image-rendering: pixelated; }\n.action-btn:hover { background: #7A81E8 !important; transform: translate(-2px, -2px); box-shadow: 6px 6px 0 rgba(0,0,0,0.3); }\n.action-btn.active { opacity: 1; transform: translateY(0); pointer-events: auto; }\n.action-btn.secondary { background: #434791 !important; }\n.action-btn.secondary:hover { background: #595EB5 !important; }\n\n\n/* Shooting Star */\n.shooting-star { position: absolute; width: 60px; height: 4px; background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,0.8), #fff); transform: rotate(-35deg); opacity: 0; animation: shooting 12s linear infinite; pointer-events: none; }\n@keyframes shooting { 0% { transform: translate(120vw, -20vh) rotate(-35deg) scale(1); opacity: 0; } 2% { opacity: 1; } 8% { transform: translate(-20vw, 80vh) rotate(-35deg) scale(1); opacity: 0; } 100% { opacity: 0; } }\n\n/* Sparkles */\n.magical-sparkle { position: absolute; font-size: 24px; color: var(--yel); opacity: 0; pointer-events: none; transition: all 1s; filter: drop-shadow(2px 2px 0 var(--bdr)); z-index: 60; }\n.card-fullscreen.open ~ .magical-sparkle, .item-positioner.opened ~ .magical-sparkle { animation: sparkle-pop 2s ease-in-out infinite alternate; }\n@keyframes sparkle-pop { 0% { transform: scale(0) rotate(0deg); opacity: 0; } 50% { transform: scale(1.5) rotate(180deg); opacity: 1; } 100% { transform: scale(0.8) rotate(360deg); opacity: 0; } }\n\n/* --- 2D SCENE CONTAINER --- */\n#scene { position: fixed; inset: 0; z-index: 10; display: block; perspective: 2000px; }\n\n/* --- IDLE ANIMATIONS --- */\n@keyframes float-left { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-12px) rotate(0deg); } }\n@keyframes float-right { 0%, 100% { transform: translateY(0) rotate(2deg); } 50% { transform: translateY(-10px) rotate(0deg); } }\n@keyframes drop-shadow-pulse { \n  0%, 100% { filter: drop-shadow(8px 8px 0 rgba(0,0,0,0.2)) drop-shadow(0 0 10px rgba(255,184,208,0.2)); } \n  50% { filter: drop-shadow(12px 16px 0 rgba(0,0,0,0.15)) drop-shadow(0 0 30px rgba(255,184,208,0.7)); } \n}\n\n.idle-float { animation: float-left 4s ease-in-out infinite, drop-shadow-pulse 4s ease-in-out infinite; }\n.idle-float-alt { animation: float-right 3.5s ease-in-out infinite, drop-shadow-pulse 3.5s ease-in-out infinite; }\n.idle-float .envelope-seal { animation: heartbeat 1.2s infinite; }\n\n.card-fullscreen {\n  position: fixed; left: 50%; top: 50%; width: 420px; height: 600px;\n  transform: translate(-50%, -50%) scale(0.8); z-index: 50; display: flex;\n  pointer-events: none; opacity: 0; transition: all 1.2s cubic-bezier(0.34, 1.8, 0.64, 1);\n  background: var(--cream); border-radius: 0px; border: 4px solid var(--bdr);\n  box-shadow: 12px 12px 0 rgba(0,0,0,0.15);\n  flex-direction: column; overflow-y: auto; overflow-x: hidden;\n  scrollbar-width: none; -ms-overflow-style: none;\n}\n.card-fullscreen::-webkit-scrollbar { display: none; }\n.card-fullscreen.open {\n  opacity: 1; transform: translate(-50%, -50%) scale(1); pointer-events: auto;\n}\n.letter-content-scroll {\n  padding: 50px 40px 40px 40px; font-family: var(--letter-font, 'Caveat'), cursive; font-size: 24px; line-height: 40px;\n  color: var(--br); width: 100%; box-sizing: border-box; position: relative;\n  background-image: repeating-linear-gradient(transparent, transparent 39px, rgba(0,0,0,0.06) 39px, rgba(0,0,0,0.06) 40px);\n  background-position: 0 45px;\n  background-attachment: local;\n}\n.letter-content-scroll .polaroid { margin: 40px auto; transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s ease; }\n.letter-content-scroll .polaroid:hover { transform: scale(1.05) rotate(0deg) translateY(-5px) !important; box-shadow: 0 15px 30px rgba(0,0,0,0.3); z-index: 10; }\n.letter-content-scroll::before {\n  content: ''; position: absolute; top: -10px; left: 50%; transform: translateX(-50%) rotate(-2deg);\n  width: 120px; height: 30px; background: rgba(255,255,255,0.5); border: 1px solid rgba(0,0,0,0.05);\n  box-shadow: 0 2px 5px rgba(0,0,0,0.05);\n}\n\n.card-fullscreen.open .letter-reveal {\n  opacity: 0;\n  animation: letter-reveal-anim 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;\n  animation-delay: var(--delay, 1.0s);\n}\n@keyframes letter-reveal-anim {\n  0% { opacity: 0; transform: translateY(15px); filter: blur(4px); }\n  100% { opacity: 1; transform: translateY(0); filter: blur(0px); }\n}\n.letter-para { margin-bottom: 20px; text-align: justify; padding-right: 5px; }\n.page-front, .page-back {\n  position: absolute; top: 0; left: 0; width: 100%; height: 100%;\n  -webkit-backface-visibility: hidden; backface-visibility: hidden; background: var(--cream);\n  border-left: 4px solid var(--bdr); border-right: 4px solid var(--bdr);\n}\n.page-back { transform: rotateY(180deg); }\n.page-content {\n  padding: 40px; font-family: var(--letter-font, 'Caveat'), cursive; font-size: 26px; line-height: 40px;\n  color: var(--br); width: 100%; height: 100%; box-sizing: border-box; overflow: hidden;\n}\n.page-number {\n  position: absolute; bottom: 15px; width: 100%; text-align: center;\n  font-family: 'Nunito', sans-serif; font-weight: 800; letter-spacing: 0.02em; font-size: 8px; color: rgba(0,0,0,0.2); pointer-events: none;\n}\n.photo-content { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; flex-direction: column; background: #fff; border: 4px solid var(--bdr); box-sizing: border-box; padding: 12px 12px 40px 12px; }\n\n\n/* --- SEAMLESS POSITIONERS --- */\n.item-positioner { position: absolute; bottom: 18vh; transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1); cursor: pointer; z-index: 20; animation: idle-float 3s ease-in-out infinite; }\n@keyframes idle-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }\n.item-positioner.picked-up, .item-positioner.opened, .item-positioner.hidden { animation: none !important; }\n.item-inner { position: absolute; inset: 0; transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.4s; -webkit-transform-style: preserve-3d; transform-style: preserve-3d; }\n\n#envPos { left: 35%; transform: translateX(-50%); width: 280px; height: 180px; }\n#albPos { left: 65%; transform: translateX(-50%); width: 260px; height: 360px; }\n\n.item-positioner:hover .item-inner { transform: translateY(-8px); filter: drop-shadow(8px 12px 0 rgba(0,0,0,0.2)); animation: none; }\n\n\n#albPos.picked-up { transform: translate(-50%, 50%) scale(1.8) !important; }\n.item-positioner.picked-up { left: 50%; bottom: 50%; transform: translate(-50%, 50%) scale(1.6); cursor: default; z-index: 30; }\n.item-positioner.picked-up .item-inner { transform: none !important; filter: drop-shadow(24px 24px 0 rgba(0,0,0,0.4)); animation: none; }\n\n.item-positioner.hidden { opacity: 0 !important; pointer-events: none !important; bottom: -20vh !important; transform: translate(-50%, 50%) scale(0.5) !important; z-index: 10; }\n\n/* --- ENVELOPE PARTS --- */\n.envelope-back { position: absolute; inset: 0; background: var(--peach); border: 4px solid var(--bdr); transform: translateZ(-2px); box-shadow: 4px 4px 0 rgba(0,0,0,0.2); }\n.envelope-front { position: absolute; inset: 0; background: var(--cream); border: 4px solid var(--bdr); border-top: none; z-index: 3; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; padding-bottom: 25px; transform: translateZ(2px); box-shadow: none; }\n.envelope-front::before { display: none; }\n\n.envelope-stamp {\n  position: absolute; top: 12px; right: 16px; width: 44px; height: 50px;\n  background: var(--blush); border: 4px solid var(--bdr);\n  display: flex; align-items: center; justify-content: center; font-size: 24px;\n  transform: rotate(4deg); box-shadow: none; padding: 4px;\n}\n.envelope-stamp::after { content: '🌸'; filter: none; }\n\n.envelope-front-strip { position: absolute; top: 0; left: 0; width: 100%; height: 30px; background: repeating-linear-gradient(45deg, var(--blush), var(--blush) 20px, var(--peach) 20px, var(--peach) 40px); border-bottom: 4px solid var(--bdr); box-shadow: 0 4px 0 rgba(0,0,0,0.1); }\n.envelope-text { font-family: 'Caveat', cursive; font-size: 36px; font-weight: bold; color: var(--br); margin-top: 20px; z-index: 4; text-shadow: 2px 2px 0 rgba(0,0,0,0.1); }\n\n.envelope-flap { position: absolute; top: 0; left: 0; right: 0; height: 100px; background: var(--peach); border: 4px solid var(--bdr); transform-origin: top; transition: transform 1.2s cubic-bezier(0.34, 1.8, 0.64, 1); z-index: 4; border-bottom-left-radius: 40px; border-bottom-right-radius: 40px; -webkit-transform-style: preserve-3d; transform-style: preserve-3d; transform: translateZ(4px); box-shadow: 0 4px 0 rgba(0,0,0,0.15); }\n.item-positioner.opened .envelope-flap { transform: rotateX(180deg) translateZ(4px); z-index: 1; }\n\n\n\n/* The Card (Nested inside envelope initially) */\n.card-mini { position: absolute; inset: 10px; z-index: 2; transition: transform 1s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s; background: var(--cream); border: 4px solid var(--bdr); display: flex; align-items: center; justify-content: center; box-shadow: 4px 4px 0 rgba(0,0,0,0.1); opacity: 1; }\n.card-mini::before { content: ''; position: absolute; inset: 0; background-image: repeating-linear-gradient(transparent, transparent 19px, rgba(0,0,0,0.1) 19px, rgba(0,0,0,0.1) 20px); pointer-events: none; opacity: 0.5; }\n.item-positioner.drawn-out .card-mini { transform: translateY(-160px) rotate(-3deg); z-index: 5; filter: drop-shadow(4px 4px 0 rgba(0,0,0,0.3)); }\n\n/* --- FULLSCREEN CARD (The actual readable letter) --- */\n.card-fullscreen { position: fixed; left: 50%; top: 50%; width: 720px; height: 480px; z-index: 50; display: flex; pointer-events: none;\n  opacity: 0; transform: translate(-50%, 20%) scale(0.4) rotate(-3deg);\n  transition: all 1s cubic-bezier(0.34, 1.56, 0.64, 1);\n  perspective: 2000px; /* CRITICAL FOR 3D BIFOLD EFFECT */\n}\n.card-fullscreen.active {\n  opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(0deg); pointer-events: auto;\n  filter: drop-shadow(10px 10px 0 rgba(0,0,0,0.3));\n}\n\n.item-positioner.opened .book-cover-text { opacity: 0; }\n.card-face.front { transform: rotateY(0deg); padding: 24px; background: var(--peach); border: 4px solid var(--bdr); }\n.card-face.back { transform: rotateY(180deg); padding: 20px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--cream); border: 4px solid var(--bdr); }\n\n.letter-lines { position: absolute; inset: 0; background-image: repeating-linear-gradient(transparent, transparent 38px, rgba(200,168,255,0.3) 38px, rgba(200,168,255,0.3) 40px); pointer-events: none; }\n.letter-content { position: relative; z-index: 2; font-family: var(--letter-font, 'Caveat'), cursive; font-size: 26px; font-weight: bold; line-height: 40px; color: var(--br); padding-top: 40px; opacity: 0; transform: translateY(10px); transition: all 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s; }\n.card-fullscreen.open .letter-content { opacity: 1; transform: translateY(0); }\n.letter-title { font-size: 34px; margin-bottom: 10px; }\n\n.polaroid { position: relative; background: var(--cream); padding: 12px 12px 40px 12px; border: 4px solid var(--bdr); box-shadow: 6px 6px 0 rgba(0,0,0,0.15); width: 85%; margin: 20px auto; transform: rotate(-2deg); transition: transform 0.1s, box-shadow 0.1s; cursor: pointer; }\n.polaroid::after { display: none; }\n.polaroid:hover { transform: scale(1.02) rotate(1deg) translateY(-4px); box-shadow: 10px 10px 0 rgba(0,0,0,0.2); z-index: 10; }\n.polaroid img { width: 100%; height: 240px; object-fit: contain; background: #fff; border: 4px solid var(--bdr); image-rendering: pixelated; }\n\n.tape { position: absolute; top: -12px; left: 50%; transform: translateX(-50%) rotate(-5deg); width: 90px; height: 28px; background: #FFE066; border: 4px solid var(--bdr); box-shadow: 4px 4px 0 rgba(0,0,0,0.15); z-index: 5; image-rendering: pixelated; }\n\n\n/* --- ALBUM SYSTEM --- */\n.album-wrapper { position: absolute; inset: 0; -webkit-transform-style: preserve-3d; transform-style: preserve-3d; }\n.book-cover, .book-back { \n  position: absolute; inset: 0; background-color: #A03B3B; \n  background-image: repeating-linear-gradient(45deg, rgba(0,0,0,0.05) 25%, transparent 25%, transparent 75%, rgba(0,0,0,0.05) 75%, rgba(0,0,0,0.05));\n  background-size: 8px 8px; border: 4px solid var(--bdr); border-radius: 4px 16px 16px 4px; \n  box-shadow: 4px 4px 0 rgba(0,0,0,0.2); \n}\n.book-cover { transform-origin: left; transition: transform 1.2s cubic-bezier(0.34, 1.8, 0.64, 1); -webkit-transform-style: preserve-3d; transform-style: preserve-3d; z-index: 30; transform: translateZ(2px); }\n.book-back { z-index: 1; transform: translateZ(-2px); box-shadow: 4px 4px 0 rgba(0,0,0,0.2); }\n.book-cover::after { \n  content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 40px; \n  background: rgba(0,0,0,0.15); border-right: 4px solid var(--bdr);\n}\n.book-cover-text { \n  position: absolute; left: 55%; top: 50%; transform: translate(-50%, -50%); \n  background: #FFF8E7; border: 4px solid var(--bdr); border-radius: 0px;\n  padding: 14px 20px; font-family: 'Nunito', sans-serif; font-weight: 800; letter-spacing: 2px; font-size: 18px; \n  text-align: center; line-height: 1.4; color: var(--br); \n  box-shadow: 4px 4px 0 rgba(0,0,0,0.15); \n  text-shadow: none; image-rendering: pixelated;\n}\n.item-positioner.opened .book-cover { transform: rotateY(-180deg) translateZ(2px); }\n\n.book-page { position: absolute; inset: 4px; left: 16px; background: var(--cream); border: 4px solid var(--bdr); border-radius: 2px 12px 12px 2px; transform-origin: left; transition: transform 1.2s cubic-bezier(0.34, 1.8, 0.64, 1); -webkit-transform-style: preserve-3d; transform-style: preserve-3d; z-index: 10; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: -4px 0 0 rgba(0,0,0,0.05); transform: translateZ(var(--z, 0px)); }\n.book-page.flipped { transform: rotateY(-180deg) translateZ(var(--z, 0px)); }\n\n.page-face { position: absolute; inset: 0; -webkit-backface-visibility: hidden; backface-visibility: hidden; padding: 16px; display: flex; flex-direction: column; align-items: center; justify-content: center; background-image: none; background-color: var(--cream); }\n.page-face.front { transform: rotateY(0deg) translateZ(1px); -webkit-transform: rotateY(0deg) translateZ(1px); }\n.page-face.back { transform: rotateY(180deg) translateZ(1px); -webkit-transform: rotateY(180deg) translateZ(1px); background-color: #E8DFD5; }\n.page-face.front::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.1), transparent 30%); opacity: 0; transition: opacity 0.8s; pointer-events: none; }\n.book-page.flipped .page-face.front::after { opacity: 1; }\n.page-face.back::before { content: ''; position: absolute; inset: 0; background: linear-gradient(to left, rgba(0,0,0,0.15), transparent 40%); opacity: 1; transition: opacity 0.8s; pointer-events: none; }\n.book-page.flipped .page-face.back::before { opacity: 0; }\n\n\n.page-title { font-family: 'Caveat', cursive; font-size: 40px; font-weight: bold; margin-bottom: 20px; text-shadow: 2px 2px 0 rgba(0,0,0,0.1); }\n.photo-caption { font-family: 'Nunito', sans-serif; font-size: 16px; font-weight: 800; color: var(--br); background: var(--cream); padding: 8px 16px; box-shadow: 2px 2px 0 var(--bdr); border: 4px solid var(--bdr); border-radius: 0; transform: rotate(-2deg); margin-top: 15px; image-rendering: pixelated; }\n\n\n/* --- MOBILE RESPONSIVENESS --- */\n@media (max-aspect-ratio: 4/5) {\n  /* On portrait screens, elegantly rotate the letter so the user reads it naturally sideways */\n  .card-fullscreen.active { transform: translate(-50%, -50%) scale(0.65) rotate(90deg) !important; }\n  /* Scale down the album and envelope so they don't overflow */\n  \n#albPos.picked-up { transform: translate(-50%, 50%) scale(1.8) !important; }\n.item-positioner.picked-up { transform: translate(-50%, 50%) scale(0.85) !important; }\n}\n@media (max-width: 400px) {\n  .card-fullscreen.active { transform: translate(-50%, -50%) scale(0.55) rotate(90deg) !important; }\n  \n#albPos.picked-up { transform: translate(-50%, 50%) scale(1.8) !important; }\n.item-positioner.picked-up { transform: translate(-50%, 50%) scale(0.7) !important; }\n}\n@media (max-width: 480px) {\n  .btn, .status-chip { font-size: 8px; padding: 10px 12px; }\n  .bottom-bar { gap: 8px; }\n}\n\n.sprite-mailbox {\n  width: 5px; height: 5px;\n  background: transparent;\n  box-shadow: 30px 0px #332222,\n  35px 0px #332222,\n  40px 0px #332222,\n  45px 0px #332222,\n  20px 5px #332222,\n  25px 5px #332222,\n  30px 5px #D9453B,\n  35px 5px #D9453B,\n  40px 5px #D9453B,\n  45px 5px #D9453B,\n  50px 5px #332222,\n  55px 5px #332222,\n  15px 10px #332222,\n  20px 10px #D9453B,\n  25px 10px #D9453B,\n  30px 10px #D9453B,\n  35px 10px #D9453B,\n  40px 10px #D9453B,\n  45px 10px #D9453B,\n  50px 10px #D9453B,\n  55px 10px #D9453B,\n  60px 10px #332222,\n  10px 15px #332222,\n  15px 15px #D9453B,\n  20px 15px #D9453B,\n  25px 15px #D9453B,\n  30px 15px #F4B41A,\n  35px 15px #F4B41A,\n  40px 15px #F4B41A,\n  45px 15px #F4B41A,\n  50px 15px #F4B41A,\n  55px 15px #D9453B,\n  60px 15px #D9453B,\n  65px 15px