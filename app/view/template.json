x 36px #FFFDF5,\n  72px 36px #FFFDF5,\n  78px 36px #FFFDF5,\n  84px 36px #937B66,\n  6px 42px #937B66,\n  12px 42px #FFFDF5,\n  18px 42px #FFFDF5,\n  24px 42px #FFFDF5,\n  30px 42px #FFFDF5,\n  36px 42px #FFFDF5,\n  42px 42px #FFFDF5,\n  48px 42px #FFFDF5,\n  54px 42px #FFFDF5,\n  60px 42px #FFFDF5,\n  66px 42px #FFFDF5,\n  72px 42px #FFFDF5,\n  78px 42px #FFFDF5,\n  84px 42px #937B66,\n  6px 48px #937B66,\n  12px 48px #FFFDF5,\n  18px 48px #FFFDF5,\n  24px 48px #FFFDF5,\n  30px 48px #FFFDF5,\n  36px 48px #FFFDF5,\n  42px 48px #FFFDF5,\n  48px 48px #FFFDF5,\n  54px 48px #FFFDF5,\n  60px 48px #FFFDF5,\n  66px 48px #FFFDF5,\n  72px 48px #FFFDF5,\n  78px 48px #FFFDF5,\n  84px 48px #937B66,\n  6px 54px #937B66,\n  12px 54px #937B66,\n  18px 54px #937B66,\n  24px 54px #937B66,\n  30px 54px #937B66,\n  36px 54px #937B66,\n  42px 54px #937B66,\n  48px 54px #937B66,\n  54px 54px #937B66,\n  60px 54px #937B66,\n  66px 54px #937B66,\n  72px 54px #937B66,\n  78px 54px #937B66,\n  84px 54px #937B66;\n}\n\n.sprite-teacup {\n  width: 5px; height: 5px;\n  background: transparent;\n  box-shadow: 10px 0px #5C3D2E,\n  15px 0px #5C3D2E,\n  20px 0px #5C3D2E,\n  25px 0px #5C3D2E,\n  30px 0px #5C3D2E,\n  35px 0px #5C3D2E,\n  40px 0px #5C3D2E,\n  45px 0px #5C3D2E,\n  5px 5px #5C3D2E,\n  10px 5px #FFFDF5,\n  15px 5px #FFFDF5,\n  20px 5px #FFFDF5,\n  25px 5px #FFFDF5,\n  30px 5px #FFFDF5,\n  35px 5px #FFFDF5,\n  40px 5px #FFFDF5,\n  45px 5px #FFFDF5,\n  50px 5px #5C3D2E,\n  5px 10px #5C3D2E,\n  10px 10px #FFFDF5,\n  15px 10px #4A3728,\n  20px 10px #4A3728,\n  25px 10px #4A3728,\n  30px 10px #4A3728,\n  35px 10px #4A3728,\n  40px 10px #4A3728,\n  45px 10px #FFFDF5,\n  50px 10px #5C3D2E,\n  5px 15px #5C3D2E,\n  10px 15px #FFFDF5,\n  15px 15px #FFFDF5,\n  20px 15px #FFFDF5,\n  25px 15px #FFFDF5,\n  30px 15px #FFFDF5,\n  35px 15px #FFFDF5,\n  40px 15px #FFFDF5,\n  45px 15px #FFFDF5,\n  50px 15px #5C3D2E,\n  55px 15px #5C3D2E,\n  5px 20px #5C3D2E,\n  10px 20px #FFFDF5,\n  15px 20px #FFFDF5,\n  20px 20px #FFFDF5,\n  25px 20px #FFFDF5,\n  30px 20px #FFFDF5;\n}\n\n\n    /* End of CSS */\n  \n/* --- Nostalgia Enhancements --- */\n.sunbeams {\n  position: fixed;\n  top: -50%; left: -50%;\n  width: 200%; height: 200%;\n  background: linear-gradient(135deg, rgba(255, 230, 180, 0) 0%, rgba(255, 210, 150, 0.08) 30%, rgba(255, 230, 180, 0) 60%);\n  transform-origin: center;\n  animation: driftLight 60s infinite linear;\n  pointer-events: none;\n  z-index: 5;\n  mix-blend-mode: soft-light;\n}\n@keyframes driftLight {\n  0% { transform: rotate(0deg) translate(0, 0); }\n  50% { transform: rotate(5deg) translate(-20px, 10px); }\n  100% { transform: rotate(0deg) translate(0, 0); }\n}\n\n.dust-mote {\n  position: absolute;\n  width: 3px; height: 3px;\n  background: rgba(255, 240, 200, 0.4);\n  border-radius: 50%;\n  pointer-events: none;\n  filter: blur(1px);\n  animation: floatMote 15s infinite ease-in-out;\n  z-index: 6;\n}\n@keyframes floatMote {\n  0%, 100% { transform: translate(0, 0) scale(1); opacity: 0; }\n  25% { opacity: 0.8; filter: blur(1px) drop-shadow(0 0 4px rgba(255,220,150,0.8)); }\n  50% { transform: translate(20px, -30px) scale(1.5); opacity: 0; }\n  75% { opacity: 0.6; filter: blur(1px) drop-shadow(0 0 4px rgba(255,220,150,0.8)); }\n}\n\n.lt-body, .page-content {\n  text-shadow: 0px 0px 1px rgba(10, 10, 30, 0.4), 0px 1px 2px rgba(10, 10, 30, 0.2), 0px 0px 3px rgba(10, 10, 30, 0.1);\n  letter-spacing: 0.5px;\n}\n\n.sprite-teacup, .sprite-env, .book-page, .letter-book-page, .envelope-wrapper, .letter-paper {\n  box-shadow: 0 5px 15px rgba(0,0,0,0.2), 0 15px 35px rgba(0,0,0,0.1), 0 30px 60px rgba(0,0,0,0.1) !important;\n}\n\n.fly-away {\n  animation: flyAway 3s cubic-bezier(0.25, 1, 0.5, 1) forwards !important;\n}\n@keyframes flyAway {\n  0% { transform: translate(0, 0) scale(1) rotate(0deg); opacity: 1; }\n  20% { transform: translate(0, -20px) scale(1.05) rotate(2deg); opacity: 1; }\n  100% { transform: translate(200px, -500px) scale(0.5) rotate(15deg); opacity: 0; }\n}\n\n.particle {\n  position: absolute;\n  width: 6px; height: 6px;\n  background: var(--wax-red);\n  border-radius: 50%;\n  pointer-events: none;\n  z-index: 100;\n  transition: all 1s cubic-bezier(0.1, 0.8, 0.2, 1);\n}\n\n  \n.photo-lightbox { position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 9999; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s; backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); }\n.photo-lightbox.active { opacity: 1; pointer-events: auto; cursor: pointer; }\n.photo-lightbox img { max-width: 90vw; max-height: 90vh; border-radius: 8px; box-shadow: 0 10px 40px rgba(0,0,0,0.5); border: 4px solid #fff; transform: scale(0.95); transition: transform 0.3s; }\n.photo-lightbox.active img { transform: scale(1); }\n\n.page-front { transform: rotateY(0deg) translateZ(1px); -webkit-transform: rotateY(0deg) translateZ(1px); }\n.page-back { transform: rotateY(180deg) translateZ(1px); -webkit-transform: rotateY(180deg) translateZ(1px); box-shadow: inset -18px 0 35px rgba(0,0,0,0.06), -4px 4px 15px rgba(0,0,0,0.1); }\n\n.page-back *, .page-front *, .page-face.back *, .page-face.front * {\n  -webkit-backface-visibility: hidden;\n  backface-visibility: hidden;\n}\n\n.page-content {\n  -webkit-transform: translateZ(0);\n  transform: translateZ(0);\n}\n</style>\n</head>\n<body>\n\n<div id=\"photoLightbox\" class=\"photo-lightbox\" onclick=\"this.classList.remove('active')\">\n  <img id=\"lightboxImg\" src=\"\" alt=\"Enlarged Photo\">\n</div>\n\n  <div class=\"sunbeams\"></div>\n  <div id=\"loadingScreen\">Unfolding your letter… 💌</div>\n  <div class=\"status-chip\" id=\"statusChip\"></div>\n  <div id=\"environment\">\n    <div id=\"stars\"></div>\n    <div id=\"desk\"></div>\n  </div>\n  <div id=\"scanlines\"></div>\n\n  <div id=\"envPos\" class=\"item-positioner idle-float\" onclick=\"handleEnvelope()\">\n    <div id=\"envInner\" class=\"item-inner envelope-wrapper\">\n      <div class=\"envelope-back\"></div>\n      <div class=\"letter-paper\" id=\"envPaper\"></div>\n      <div class=\"envelope-front\">\n        <div class=\"envelope-stamp\"></div>\n        <div class=\"envelope-front-strip\"></div>\n        <div class=\"envelope-text\" id=\"envToText\"></div>\n      </div>\n      <div class=\"envelope-flap\" id=\"envFlap\">\n        \n      </div>\n    </div>\n  </div>\n\n  <div id=\"albPos\" class=\"item-positioner idle-float-alt\" onclick=\"handleAlbum()\">\n    <div id=\"albInner\" class=\"item-inner book-wrapper\">\n      <div class=\"book-back\"></div>\n      <div id=\"albumPagesContainer\"></div>\n      <div class=\"book-cover\">\n        <div class=\"book-cover-text\">OUR<br>MEMORIES</div>\n      </div>\n    </div>\n  </div>\n\n  <div id=\"letterBookView\" class=\"card-fullscreen\">\n    <div id=\"letterPagesContainer\" class=\"letter-content-scroll\"></div>\n  </div>\n  <div id=\"cardMini\"></div>\n  <div class=\"bottom-bar\" style=\"position:fixed; bottom:20px; left:0; width:100%; z-index:100;\">\n    <button id=\"prevBtn\" class=\"action-btn\" onclick=\"turnPage(-1)\">&lt; PREV</button>\n    <button id=\"nextBtn\" class=\"action-btn\" onclick=\"turnPage(1)\">NEXT &gt;</button>\n    <button id=\"closeBtn\" class=\"action-btn secondary\" onclick=\"closeActive()\">CLOSE</button>\n  </div>\n<style>\n.end-moment{position:fixed;left:50%;bottom:96px;transform:translate(-50%,24px);z-index:120;width:min(420px,92vw);background:#FFFDF5;border:4px solid #5C3D2E;border-radius:18px;box-shadow:6px 6px 0 #5C3D2E;padding:18px 18px 16px;text-align:center;opacity:0;pointer-events:none;transition:opacity .5s ease,transform .5s cubic-bezier(.3,1.5,.5,1);font-family:'Nunito',sans-serif;color:#4A3728}\n.end-moment.show{opacity:1;pointer-events:auto;transform:translate(-50%,0)}\n.end-moment h3{font-family:'Caveat',cursive;font-size:32px;line-height:1.1;margin:6px 0 4px;color:#B83A68}\n.end-moment p{font-size:15px;font-weight:700;line-height:1.5;margin:0 0 12px}\n.end-moment .em-row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}\n.end-moment a,.end-moment button{min-height:44px;padding:10px 16px;font:800 15px 'Nunito',sans-serif;color:#4A3728;background:#FFB8D0;border:3px solid #5C3D2E;border-radius:999px;box-shadow:0 4px 0 #5C3D2E;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center}\n.end-moment button{background:#E9DDFF}\n.end-moment a:active,.end-moment button:active{transform:translateY(4px);box-shadow:0 0 0 #5C3D2E}\n.end-moment a:focus-visible,.end-moment button:focus-visible{outline:3px solid #6E3FD0;outline-offset:3px}\n.end-heart{position:fixed;z-index:130;pointer-events:none;font-size:24px;animation:endrise 2.4s ease-out forwards}\n@keyframes endrise{0%{transform:translateY(0) scale(.6);opacity:0}15%{opacity:1}100%{transform:translateY(-70vh) scale(1.3) rotate(18deg);opacity:0}}\n@media (prefers-reduced-motion:reduce){.end-moment{transition:none}.end-heart{display:none}}\n</style>\n<div class=\"end-moment\" id=\"endMoment\" role=\"status\" aria-live=\"polite\">\n  <div style=\"font-size:28px\" aria-hidden=\"true\">💌</div>\n  <h3 id=\"endSign\"></h3>\n  <p>You were thought of today. That's the whole point 💕</p>\n  <div class=\"em-row\">\n    <a id=\"writeBack\" href=\"#\">Write back 💌</a>\n    <button type=\"button\" id=\"keepBtn\">Keep this letter</button>\n  </div>\n</div>\n<script>\nfunction showEndMoment(){\n  var em=document.getElementById('endMoment');\n  var sg=(LETTER.sign||LETTER.from||'With love').trim();\n  document.getElementById('endSign').textContent=sg;\n  document.getElementById('writeBack').href='mailto:?subject='+encodeURIComponent('Thank you for your letter \\uD83D\\uDC8C');\n  em.classList.add('show');\n  if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n  var g=['\\uD83D\\uDC96','\\uD83D\\uDC97','\\u2728','\\uD83C\\uDF38','\\uD83D\\uDC95'];\n  for(var i=0;i<14;i++){(function(i){setTimeout(function(){\n    var h=document.createElement('div');h.className='end-heart';h.textContent=g[i%g.length];\n    h.style.left=(8+Math.random()*84)+'vw';h.style.bottom='10vh';h.style.fontSize=(18+Math.random()*16)+'px';\n    document.body.appendChild(h);setTimeout(function(){h.remove();},2500);},i*120);})(i);}\n}\nfunction hideEndMoment(){var em=document.getElementById('endMoment');if(em){em.classList.remove('show');em.dataset.done='';}}\nvar endTimer=setInterval(function(){\n  if(typeof state==='undefined'||state!=='card_open'){return;}\n  var em=document.getElementById('endMoment');if(em.classList.contains('show')||em.dataset.done==='1')return;\n  var els=[document.getElementById('letterPagesContainer'),document.getElementById('letterBookView')];\n  for(var i=0;i<els.length;i++){var e=els[i];if(e&&e.scrollHeight>e.clientHeight+20&&e.scrollTop+e.clientHeight>=e.scrollHeight-60){em.dataset.done='1';showEndMoment();return;}}\n  var sign=document.querySelector('#letterBookView .letter-sign, #letterBookView [class*=\"sign\"]');\n  if(sign){var r=sign.getBoundingClientRect();if(r.top>0&&r.bottom<innerHeight-120){em.dataset.done='1';showEndMoment();}}\n},800);\ndocument.addEventListener('DOMContentLoaded',function(){\n  var k=document.getElementById('keepBtn');\n  if(k)k.addEventListener('click',function(){\n    var hint=function(){k.textContent='Press Ctrl/Cmd + S to keep it \\uD83D\\uDC9B';};\n    fetch(location.href).then(function(r){return r.text();}).then(function(t){\n      var a=document.createElement('a');a.href=URL.createObjectURL(new Blob([t],{type:'text/html'}));a.download='my-letter.html';document.body.appendChild(a);a.click();a.remove();\n      k.textContent='Saved \\uD83D\\uDC9B';\n    }).catch(hint);\n  });\n});\n</script>\n  <script>\n\nfunction enlargePhoto(src) {\n  let lightbox = document.getElementById('photoLightbox');\n  let img = document.getElementById('lightboxImg');\n  img.src = src;\n  lightbox.classList.add('active');\n}\n\nvar __EMBEDDED__ = null;\nvar LETTER = (function(){\n  if(__EMBEDDED__ && typeof __EMBEDDED__ === 'object') return __EMBEDDED__;\n  try{\n    var id = new URLSearchParams(location.search).get('id');\n    if(id){\n      var r = localStorage.getItem('ppx-letter-' + id) || sessionStorage.getItem('ppx-letter-' + id);\n      if(r) return JSON.parse(r);\n    }\n    var latest = localStorage.getItem('ppx-latest-preview') || sessionStorage.getItem('ppx-latest-preview');\n    if(latest) return JSON.parse(latest);\n  } catch(e){}\n  return {\n    to: 'Dear friend,',\n    body: 'I was sitting by the window this evening, watching the sky turn that particular shade of orange you always said looked like the inside of a mango, and I thought of you.\\n\\nI don\\'t know why we stop calling the people we love most. Maybe it\\'s because we think they already know. But I wanted to write it down anyway — you are one of the best parts of my life. ✨',\n    sign: 'With so much love,\\nPenPal Pixel 🌸',\n    date: new Date().toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'}),\n    from: 'PenPal Pixel', photos: [] \n  };\n})();\n\nvar state = 'desk'; // desk, env_picked, card_open, album_picked\nvar isAnimating = false;\nvar currentAlbumPage = 0;\nvar totalAlbumPages = 0;\nvar currentLetterPage = 0;\nvar totalLetterPages = 0;\n\ndocument.addEventListener('DOMContentLoaded', function(){\n\n  // Fix Logical Bug: Apply user's selected paper theme to the viewer\n  var themes = { c: '#FFFDF5', l: '#F8F2FF', b: '#FFF0F6', m: '#EFFFFA', s: '#EFF7FF', p: '#FFF5EA' };\n  if(LETTER.paper && themes[LETTER.paper]){\n    document.documentElement.style.setProperty('--cream', themes[LETTER.paper]);\n  }\n\n  // Apply the sender's chosen handwriting font (was previously ignored on export)\n  document.documentElement.style.setProperty('--letter-font', LETTER.font || \"'Caveat'\");\n\n  \n  // Spawn Golden Hour Dust Motes\n  var env = document.getElementById('environment');\n  for(let i=0; i<35; i++){\n    var mote = document.createElement('div');\n    mote.className = 'dust-mote';\n    mote.style.left = (Math.random() * 100) + 'vw';\n    mote.style.top = (Math.random() * 100) + 'vh';\n    mote.style.animationDuration = (12 + Math.random() * 20) + 's';\n    mote.style.animationDelay = '-' + (Math.random() * 20) + 's';\n    env.appendChild(mote);\n  }\n\n  document.getElementById('envToText').textContent = 'To: ' + (LETTER.to || 'Dear friend');\n\n  function escapeHTML(str) {\n  return (str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n}\n  var photos = LETTER.photos || [];\n  \n  \n  \n  // LETTER RENDERING ENGINE (Scrollable)\n  var letterContainer = document.getElementById('letterPagesContainer');\n  letterContainer.innerHTML = ''; // Clear\n  \n  var delayTime = 1.0;\n  var dateHTML = LETTER.date ? `<div class=\"letter-reveal\" style=\"--delay: ${delayTime}s; text-align:right; font-size: 18px; opacity:0.7; margin-bottom: 20px;\">${escapeHTML(LETTER.date)}</div>` : '';\n  delayTime += 0.2;\n  \n  var titleHTML = LETTER.to ? `<div class=\"letter-reveal letter-title\" style=\"--delay: ${delayTime}s; margin-bottom:15px; font-size: 32px;\">${escapeHTML(LETTER.to)}</div>` : '';\n  if(LETTER.to) delayTime += 0.2;\n  \n  var paragraphs = (LETTER.body || '').split(/(?:\\r\\n|\\r|\\n){2,}/);\n  var bodyHTML = '';\n  for(let i=0; i<paragraphs.length; i++){\n    if(paragraphs[i].trim() === '') continue;\n    let paraContent = escapeHTML(paragraphs[i]).replace(/\\n/g, '<br>');\n    bodyHTML += `<p class=\"letter-reveal letter-para\" style=\"--delay: ${delayTime}s;\">${paraContent}</p>`;\n    delayTime += 0.2;\n  }\n  \n  var signHTML = `<div class=\"letter-reveal\" style=\"--delay: ${delayTime}s; margin-top:40px; display:flex; align-items:center; justify-content:flex-end; gap:10px;\">\n                    <div>${escapeHTML(LETTER.sign || 'With love').replace(/\\n/g, '<br>')}</div>\n                    <div style=\"font-size:32px; filter:hue-rotate(-20deg) opacity(0.8);\">💌</div>\n                  </div>`;\n  \n  var postmarkSVG = `\n    <svg width=\"80\" height=\"80\" viewBox=\"0 0 100 100\" style=\"position:absolute; top: 15px; right: 25px; opacity: 0.2; transform: rotate(15deg); pointer-events:none; mix-blend-mode: multiply;\">\n      <circle cx=\"50\" cy=\"50\" r=\"45\" fill=\"none\" stroke=\"#5a3a22\" stroke-width=\"2\" stroke-dasharray=\"4 2\"/>\n      <circle cx=\"50\" cy=\"50\" r=\"35\" fill=\"none\" stroke=\"#5a3a22\" stroke-width=\"1\"/>\n      <text x=\"50\" y=\"45\" font-size=\"12\" fill=\"#5a3a22\" font-family=\"sans-serif\" text-anchor=\"middle\" font-weight=\"bold\" letter-spacing=\"1\">PAR AVION</text>\n      <text x=\"50\" y=\"65\" font-size=\"10\" fill=\"#5a3a22\" font-family=\"sans-serif\" text-anchor=\"middle\" letter-spacing=\"1\">AIR MAIL</text>\n      <path d=\"M 0 50 Q 25 30, 50 50 T 100 50\" fill=\"none\" stroke=\"#5a3a22\" stroke-width=\"1\" opacity=\"0.6\"/>\n      <path d=\"M 0 60 Q 25 40, 50 60 T 100 60\" fill=\"none\" stroke=\"#5a3a22\" stroke-width=\"1\" opacity=\"0.6\"/>\n    </svg>`;\n    \n  var coffeeStainSVG = `\n    <svg width=\"250\" height=\"250\" viewBox=\"0 0 100 100\" style=\"position:absolute; bottom: 80px; left: -40px; opacity: 0.12; transform: rotate(-25deg); pointer-events:none; mix-blend-mode: multiply;\">\n      <circle cx=\"50\" cy=\"50\" r=\"40\" fill=\"none\" stroke=\"#4a2e15\" stroke-width=\"3\" opacity=\"0.8\"/>\n      <circle cx=\"53\" cy=\"48\" r=\"38\" fill=\"none\" stroke=\"#4a2e15\" stroke-width=\"1.5\" opacity=\"0.5\"/>\n      <circle cx=\"48\" cy=\"52\" r=\"41\" fill=\"none\" stroke=\"#4a2e15\" stroke-width=\"2\" stroke-dasharray=\"20 5 10 5\" opacity=\"0.6\"/>\n      <circle cx=\"15\" cy=\"75\" r=\"4\" fill=\"#4a2e15\" opacity=\"0.7\"/>\n      <circle cx=\"25\" cy=\"85\" r=\"2\" fill=\"#4a2e15\" opacity=\"0.5\"/>\n    </svg>`;\n  \n  var fullText = postmarkSVG + coffeeStainSVG + dateHTML + titleHTML + bodyHTML + signHTML;\n  \n  let html = `<div class=\"page-content\" style=\"overflow:visible; height:auto; min-height: 100%;\">${fullText}</div>`;\n  \n  letterContainer.innerHTML = html;\n\n\n  \n  var albumPagesContainer = document.getElementById('albumPagesContainer');\n  \n  // If no photos, make 1 page that says NO PHOTOS\n  let albumItems = [];\n  if(photos && photos.length > 0){\n    for(let i=0; i<photos.length; i++){\n      albumItems.push(`\n        <div class=\"page-title\">📖 Scrapbook</div>\n        <div class=\"polaroid\" style=\"width:90%;margin-top:10px;transform:rotate(${Math.random()*6-3}deg);\">\n          <div class=\"tape\"></div>\n          <img src=\"${escapeHTML(photos[i])}\" crossorigin=\"anonymous\" onclick=\"enlargePhoto(this.src)\" style=\"cursor:pointer; height:200px;object-fit:cover;width:100%;\">\n        </div>\n        <div class=\"photo-caption\">PHOTO #${i+1} OF ${photos.length}</div>\n      `);\n    }\n  } else {\n    albumItems.push(`\n      <div class=\"page-title\">📖 Scrapbook</div>\n      <div class=\"polaroid\" style=\"display:flex;align-items:center;justify-content:center;height:240px;background:#f0f0f0;flex-direction:column;\">\n        <div class=\"tape\"></div>\n        <span style=\"font-family:'Nunito',sans-serif;font-weight:700;font-size:13px;color:rgba(0,0,0,0.3);line-height:1.8;text-align:center;\">NO PHOTOS<br>ATTACHED~</span>\n      </div>\n    `);\n  }\n\n  totalAlbumPages = Math.ceil(albumItems.length / 2);\n\n  for(let i=0; i<totalAlbumPages; i++){\n    let frontIdx = i * 2;\n    let backIdx = i * 2 + 1;\n    \n    let frontContent = albumItems[frontIdx] || '';\n    let backContent = albumItems[backIdx] || '';\n    \n    let page = document.createElement('div');\n    page.className = 'book-page';\n    page.style.zIndex = 10 - i;\n    page.style.setProperty('--z', (-i * 0.2) + 'px');\n    page.id = 'albumPage_' + i;\n    \n    page.innerHTML = `\n      <div class=\"page-face back\">${backContent}</div>\n      <div class=\"page-face front\">${frontContent}</div>\n    `;\n    albumPagesContainer.appendChild(page);\n  }\n\n\n  setTimeout(function(){\n    document.getElementById('loadingScreen').style.opacity = '0';\n    setTimeout(() => document.getElementById('loadingScreen').remove(), 500);\n    setStatus('Someone wrote you a letter \\uD83D\\uDC8C Tap the envelope');\n  }, 500);\n});\n\nfunction setStatus(text) { document.getElementById('statusChip').innerHTML = text; }\nfunction setControls(closeBtn, navBtns) {\n  var c = document.getElementById('closeBtn');\n  let p = document.getElementById('prevBtn');\n  var n = document.getElementById('nextBtn');\n  c.className = 'btn action-btn' + (closeBtn ? ' active' : '');\n  p.className = 'btn action-btn secondary' + (navBtns ? ' active' : '');\n  n.className = 'btn action-btn secondary' + (navBtns ? ' active' : '');\n}\n\n\n  // Firefly Burst\n  function spawnEnvelopeBurst() {\n    var env = document.getElementById('envPos');\n    var rect = env.getBoundingClientRect();\n    for(let i=0; i<20; i++) {\n      let f = document.createElement('div');\n      f.className = 'env-firefly';\n      f.style.left = (rect.left + rect.width/2) + 'px';\n      f.style.top = (rect.top + rect.height/2) + 'px';\n      let angle = Math.random() * Math.PI * 2;\n      var speed = Math.random() * 150 + 50;\n      f.style.setProperty('--tx', (Math.cos(angle)*speed)+'px');\n      f.style.setProperty('--ty', (Math.sin(angle)*speed - 150)+'px');\n      document.body.appendChild(f);\n      setTimeout((function(el){ return function(){ el.remove(); } })(f), 2000);\n    }\n  }\n\n  // Interactive Particle Physics\n  document.addEventListener('mousemove', function(e) {\n    if(state !== 'desk') return;\n    var motes = document.querySelectorAll('.mote, .blossom');\n    var mx = e.clientX;\n    var my = e.clientY;\n    \n    motes.forEach(function(m){\n      var rect = m.getBoundingClientRect();\n      var dx = rect.left + rect.width/2 - mx;\n      var dy = rect.top + rect.height/2 - my;\n      let dist = Math.sqrt(dx*dx + dy*dy);\n      if(dist < 150){ \n        var force = (150 - dist) / 150;\n        var pushX = (dx / dist) * force * 60;\n        var pushY = (dy / dist) * force * 60;\n        m.style.transform = 'translate(' + pushX + 'px, ' + pushY + 'px)';\n        m.style.transition = 'transform 0.3s ease-out';\n      } else {\n        m.style.transform = '';\n        m.style.transition = 'transform 2s ease-in';\n      }\n    });\n  });\n\n  function spawnHearts(){\n  let envPos = document.getElementById('envPos');\n  for(let i=0; i<6; i++){\n    (function(idx){\n      setTimeout(function(){\n        let h = document.createElement('div');\n        h.innerHTML = '💖';\n        h.style.position = 'absolute';\n        h.style.left = '50%';\n        h.style.top = '30%';\n        h.style.fontSize = (20 + Math.random()*20) + 'px';\n        h.style.pointerEvents = 'none';\n        h.style.zIndex = 60;\n        h.style.transition = 'all 1.2s ease-out';\n        h.style.transform = 'translate(-50%, -50%) scale(0.5)';\n        h.style.opacity = '1';\n        envPos.appendChild(h);\n        \n        setTimeout(function(){\n          let tx = (Math.random() - 0.5) * 300;\n          let ty = -100 - Math.random() * 200;\n          h.style.transform = 'translate(calc(-50% + ' + tx + 'px), calc(-50% + ' + ty + 'px)) scale(1.5) rotate(' + (Math.random()*90-45) + 'deg)';\n          h.style.opacity = '0';\n        }, 50);\n        \n        setTimeout(function(){ h.remove(); }, 1200);\n      }, idx * 100);\n    })(i);\n  }\n}\n\nfunction updateNavBtns() {\n  let p = document.getElementById('prevBtn');\n  var n = document.getElementById('nextBtn');\n  \n  if (state === 'album_picked') {\n    p.style.opacity = (currentAlbumPage === 0) ? '0.3' : '1';\n    p.style.pointerEvents = (currentAlbumPage === 0) ? 'none' : 'auto';\n    n.style.opacity = (currentAlbumPage >= totalAlbumPages) ? '0.3' : '1';\n    n.style.pointerEvents = (currentAlbumPage >= totalAlbumPages) ? 'none' : 'auto';\n  } else if (state === 'card_open') {\n    p.style.opacity = (currentLetterPage === 0) ? '0.3' : '1';\n    p.style.pointerEvents = (currentLetterPage === 0) ? 'none' : 'auto';\n    n.style.opacity = (currentLetterPage >= totalLetterPages) ? '0.3' : '1';\n    n.style.pointerEvents = (currentLetterPage >= totalLetterPages) ? 'none' : 'auto';\n  }\n}\n\nfunction handleEnvelope(){\n  if(isAnimating) return;\n  \n  if(state === 'desk'){\n    isAnimating = true;\n    state = 'env_picked';\n    setStatus('OPENING ENVELOPE...');\n    \n    let envPos = document.getElementById('envPos');\n    let envInner = document.getElementById('envInner');\n    let albPos = document.getElementById('albPos');\n    \n    envInner.classList.remove('idle-float');\n    envPos.classList.add('picked-up');\n    albPos.classList.add('hidden'); \n    \n    setTimeout(function(){\n      envPos.classList.add('opened');\n      spawnHearts();\n      \n      setTimeout(function(){\n        envPos.classList.add('drawn-out');\n        \n        setTimeout(function(){\n          document.getElementById('cardMini').style.opacity = '0';\n          envPos.classList.add('hidden');\n          \n          var letterBook = document.getElementById('letterBookView');\n          letterBook.classList.add('open');\n          \n          setTimeout(function(){\n            setStatus('Take your time. Every word was written for you \\uD83D\\uDC9B');\n            setControls(true, false);\n            isAnimating = false;\n            state = 'card_open';\n          }, 1000);\n          \n        }, 1200);\n      }, 800);\n    }, 1000);\n  }\n}\n\nfunction spawnAlbumStars(){\n  let albPos = document.getElementById('albPos');\n  for(let i=0; i<8; i++){\n    (function(idx){\n      setTimeout(function(){\n        let s = document.createElement('div');\n        s.innerHTML = '✨';\n        s.style.position = 'absolute';\n        s.style.left = '50%';\n        s.style.top = '50%';\n        s.style.fontSize = (12 + Math.random()*16) + 'px';\n        s.style.pointerEvents = 'none';\n        s.style.zIndex = 60;\n        s.style.transition = 'all 1.5s cubic-bezier(0.2, 0.8, 0.2, 1)';\n        s.style.transform = 'translate(-50%, -50%) scale(0.2)';\n        s.style.opacity = '1';\n        s.style.filter = 'drop-shadow(0 0 8px #FFF)';\n        albPos.appendChild(s);\n        \n        setTimeout(function(){\n          let tx = (Math.random() - 0.5) * 400;\n          let ty = (Math.random() - 0.5) * 400;\n          s.style.transform = 'translate(calc(-50% + ' + tx + 'px), calc(-50% + ' + ty + 'px)) scale(1.5) rotate(' + (Math.random()*180) + 'deg)';\n          s.style.opacity = '0';\n        }, 50);\n        \n        setTimeout(function(){ s.remove(); }, 1500);\n      }, idx * 80);\n    })(i);\n  }\n}\n\nfunction handleAlbum(){\n  if(isAnimating) return;\n  \n  if(state === 'desk'){\n    isAnimating = true;\n    state = 'album_picked';\n    currentAlbumPage = 0;\n    if(LETTER.photos && LETTER.photos.length > 0) setStatus('ALBUM OPEN! CLICK PREV/NEXT'); else setStatus('ALBUM IS EMPTY');\n    \n    let albPos = document.getElementById('albPos');\n    let albInner = document.getElementById('albInner');\n    let envPos = document.getElementById('envPos');\n    \n    albInner.classList.remove('idle-float-alt');\n    albPos.classList.add('picked-up');\n    envPos.classList.add('hidden');\n    \n    setTimeout(function(){\n      albPos.classList.add('opened');\n      spawnAlbumStars();\n      setControls(true, totalAlbumPages > 0);\n      updateNavBtns();\n      isAnimating = false;\n    }, 1000);\n  }\n}\n\nfunction turnPage(dir){\n  if(isAnimating) return;\n  \n  if (state === 'album_picked') {\n      let nextIdx = currentAlbumPage + dir;\n      if(nextIdx >= 0 && nextIdx <= totalAlbumPages){\n        isAnimating = true;\n        \n        if(dir > 0 && currentAlbumPage < totalAlbumPages){\n          let p = document.getElementById('albumPage_' + currentAlbumPage);\n          if(p) p.classList.add('flipped');\n          currentAlbumPage++;\n        } else if(dir < 0 && currentAlbumPage > 0){\n          currentAlbumPage--;\n          let p = document.getElementById('albumPage_' + currentAlbumPage);\n          if(p) p.classList.remove('flipped');\n        }\n        \n        setTimeout(function(){ isAnimating = false; }, 800);\n        \n        if(currentAlbumPage >= totalAlbumPages) setStatus('END OF ALBUM. TAP CLOSE.');\n        else if(LETTER.photos && LETTER.photos.length > 0) setStatus('PHOTO #' + (currentAlbumPage + 1) + ' OF ' + totalAlbumPages);\n        else setStatus('ALBUM IS EMPTY');\n        updateNavBtns();\n      }\n  } else if (state === 'card_open') {\n      let nextIdx = currentLetterPage + dir;\n      if(nextIdx >= 0 && nextIdx <= totalLetterPages){\n        isAnimating = true;\n        \n        if(dir > 0 && currentLetterPage < totalLetterPages){\n          let p = document.getElementById('letterPage_' + currentLetterPage);\n          if(p) p.classList.add('flipped');\n          currentLetterPage++;\n        } else if(dir < 0 && currentLetterPage > 0){\n          currentLetterPage--;\n          let p = document.getElementById('letterPage_' + currentLetterPage);\n          if(p) p.classList.remove('flipped');\n        }\n        \n        setTimeout(function(){ isAnimating = false; }, 800);\n        \n        if(currentLetterPage >= totalLetterPages) { setStatus('That was the whole letter. Tap close when you\\u2019re ready \\uD83D\\uDC9B'); showEndMoment(); }\n        else setStatus('READING PAGE ' + (currentLetterPage + 1));\n        updateNavBtns();\n      }\n  }\n}\n\nfunction closeActive(){\n  if(isAnimating) return;\n  hideEndMoment();\n  \n  if(state === 'card_open'){\n    isAnimating = true;\n    setStatus('CLOSING LETTER...');\n    setControls(false, false);\n    \n    var letterBook = document.getElementById('letterBookView');\n    let envPos = document.getElementById('envPos');\n    let albPos = document.getElementById('albPos');\n    let envInner = document.getElementById('envInner');\n    \n    for(let i=0; i<totalLetterPages; i++){\n      let p = document.getElementById('letterPage_' + i);\n      if(p) p.classList.remove('flipped');\n    }\n    \n    setTimeout(function(){\n      letterBook.classList.remove('open');\n      envPos.classList.remove('hidden');\n      \n      setTimeout(function(){\n        document.getElementById('cardMini').style.opacity = '1';\n        envPos.classList.remove('drawn-out');\n        \n        setTimeout(function(){\n          envPos.classList.remove('opened');\n          \n          setTimeout(function(){\n            envPos.classList.remove('picked-up');\n            albPos.classList.remove('hidden');\n            \n            setTimeout(function(){\n              envInner.classList.add('idle-float');\n              state = 'desk';\n              isAnimating = false;\n              setStatus('TAP ENVELOPE OR ALBUM TO EXPLORE');\n            }, 800);\n          }, 800);\n        }, 800);\n      }, 1000);\n    }, 800);\n  } \n  else if (state === 'album_picked') {\n    isAnimating = true;\n    setStatus('CLOSING ALBUM...');\n    setControls(false, false);\n    \n    let albPos = document.getElementById('albPos');\n    let albInner = document.getElementById('albInner');\n    let envPos = document.getElementById('envPos');\n    \n    for(let i=0; i<totalAlbumPages; i++){\n      let p = document.getElementById('albumPage_' + i);\n      if(p) p.classList.remove('flipped');\n    }\n    \n    setTimeout(function(){\n      albPos.classList.remove('opened');\n      \n      setTimeout(function(){\n        albPos.classList.remove('picked-up');\n        envPos.classList.remove('hidden');\n        \n        setTimeout(function(){\n          albInner.classList.add('idle-float-alt');\n          state = 'desk';\n          isAnimating = false;\n          setStatus('TAP ENVELOPE OR ALBUM TO EXPLORE');\n        }, 800);\n      }, 800);\n    }, 800);\n  }\n}\n\ndocument.addEventListener('keydown', function(e) {\n  if (state === 'card_open' || state === 'album_open') {\n    if (e.key === 'ArrowRight') turnPage(1);\n    else if (e.key === 'ArrowLeft') turnPage(-1);\n    else if (e.key === 'Escape') closeActive();\n  }\n});\n\n// Swipe / Scroll to Turn Pages\nlet swipeStartX = 0;\ndocument.addEventListener('touchstart', e => { swipeStartX = e.changedTouches[0].screenX; });\ndocument.addEventListener('touchend', e => {\n  if (state !== 'card_open' && state !== 'album_picked') return;\n  let swipeEndX = e.changedTouches[0].screenX;\n  if (swipeStartX - swipeEndX > 50) turnPage(1);\n  else if (swipeEndX - swipeStartX > 50) turnPage(-1);\n});\n\nlet wheelTimeout;\ndocument.addEventListener('wheel', e => {\n  if (state !== 'card_open' && state !== 'album_picked') return;\n  if (wheelTimeout || isAnimating) return;\n  \n  let delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;\n  if (delta > 40) {\n    turnPage(1);\n    wheelTimeout = setTimeout(() => wheelTimeout = null, 800);\n  } else if (delta < -40) {\n    turnPage(-1);\n    wheelTimeout = setTimeout(() => wheelTimeout = null, 800);\n  }\n});\n</script>\n</body>\n</html>"